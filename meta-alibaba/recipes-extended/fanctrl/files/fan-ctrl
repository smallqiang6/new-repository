#!/usr/bin/env python

import sys
import subprocess
import traceback
from hal.hal_fan import HalFan

ERR_NONE = 0
ERR_PARAM = -1
ERR_FAIL = -2

result_string = [
    "OK",
    "Invalid parameters",
    "Operation Failed"
]


DEF_FANCTRL = "fanctrl.service"

HELP_CONTROL_DAEMON = "fan-ctrl control-daemon <start|stop|status> [SERVICE_NAME] " \
                      "Start/Stop/Show fan control service"
HELP_LIST = "fan-ctrl list                                              List all fan names"
HELP_WATCHDOG = "fan-ctrl watch-dog <enable/disable/status>                 Enable/Disable/Show hardware fan watchdog"
HELP_SPEED_SET = "fan-ctrl speed-set <FAN_NAME> <SPEED_PWM>                  Set fan speed pwm in percentage"
HELP_SPEED_GET = "fan-ctrl speed-get <FAN_NAME>                              Get fan speed pwm in percentage"


def print_usage():
    usage_list = [HELP_CONTROL_DAEMON, HELP_LIST, HELP_WATCHDOG,
                  HELP_SPEED_SET, HELP_SPEED_GET]
    usage_str = "\n".join(usage_list)
    print(usage_str)


def fan_wdt(params):
    sub_cmds = ["enable", "disable", "status"]
    if len(params) < 1:
        return ERR_PARAM

    cmd = params[0]
    if cmd not in sub_cmds:
        return ERR_PARAM

    try:
        fan = HalFan()

        if cmd == "status":
            result = fan.get_watchdog_status()
            msg = "Fan watchdog status: %s" % result
            print(msg)
        else:
            enable = True if cmd == "enable" else False
            ret = fan.enable_watchdog(enable)
            if ret != 0:
                print("Fan watchdog %s failed" % cmd)
                return ERR_FAIL
    except Exception as e:
        print("fan-ctrl watch-dog %s got exception: %s, backtrace: %s" \
               % (cmd, str(e), traceback.format_exc()))
        return ERR_FAIL

    return ERR_NONE


def fan_ctrl_daemon(params):
    sub_cmds = ["start", "stop", "status"]
    if len(params) < 1:
        return ERR_PARAM

    daemon_name = DEF_FANCTRL
    if len(params) > 1:
        daemon_name = params[1]

    cmd = params[0]
    if cmd not in sub_cmds:
        return ERR_PARAM

    cmd_str = "systemctl %s %s" % (cmd, daemon_name)
    if cmd == "status":
        cmd_str += " | more"
    cmd_param_list = cmd_str.split()
    proc = subprocess.Popen(cmd_param_list, shell=False, \
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    output = proc.communicate()[0]

    lines = output.splitlines()
    for line in lines:
        line_str = line.decode()
        if line_str.find("Loaded:") != -1 or \
            line_str.find("Active:") != -1:
            print(line_str)

    return ERR_NONE


def fan_list(params):
    try:
        fan = HalFan()
        fan_num = fan.get_total_number()
        fan_names_list = ["FAN%d" % idx for idx in range(1, fan_num+1)]
        fan_names = ", ".join(fan_names_list)
        print(fan_names)
    except:
        return ERR_FAIL

    return ERR_NONE


def fan_speed_set(params):
    if len(params) < 2:
        return ERR_PARAM

    fan_name = params[0]

    try:
        fan = HalFan()
        fan_num = fan.get_total_number()
        fan_names_list = ["FAN%d" % idx for idx in range(1, fan_num+1)]

        if fan_name not in fan_names_list:
            return ERR_PARAM

        speed_pwm = int(params[1])
        if speed_pwm not in range(0, 101):
            return ERR_PARAM

        rotor_num = fan.get_rotor_number(fan_name)
        if rotor_num < 1:
            return ERR_PARAM

        for rotor_idx in range(rotor_num):
            ret = fan.set_speed_pwm(fan_name, rotor_idx, speed_pwm)
            if ret != 0:
                return ERR_FAIL
    except:
        print(traceback.format_exc())
        return ERR_FAIL

    return ERR_NONE


def fan_speed_get(params=None):
    if len(params) < 1:
        return ERR_PARAM

    fan_name = params[0]
    try:
        fan = HalFan()
        fan_num = fan.get_total_number()
        fan_names_list = ["FAN%d" % idx for idx in range(1, fan_num+1)]
        if fan_name not in fan_names_list:
            return ERR_PARAM

        rotor_num = fan.get_rotor_number(fan_name)
        if rotor_num < 1:
            return ERR_PARAM

        speed_total = 0
        for rotor_idx in range(rotor_num):
            speed = fan.get_speed_pwm(fan_name, rotor_idx)
            if speed == -1:
                return ERR_PARAM
            speed_total += speed

        speed_avg = speed_total / (1.0 * rotor_num)
        print("{} speed PWM percentage {}".format(fan_name, speed_avg))

        return ERR_NONE
    except:
        print(traceback.format_exc())
        return ERR_FAIL



g_cmd_map = {
    "watch-dog": {"func": fan_wdt, "help": HELP_WATCHDOG},
    "list": {"func": fan_list, "help": HELP_LIST},
    "control-daemon": {"func": fan_ctrl_daemon, "help": HELP_CONTROL_DAEMON},
    "speed-set": {"func": fan_speed_set, "help": HELP_SPEED_SET},
    "speed-get": {"func": fan_speed_get, "help": HELP_SPEED_GET}
}


def parse_args():
    arg_cnt = len(sys.argv)
    if arg_cnt < 2:
        return False

    tgt = sys.argv[1]
    if tgt.lower() not in g_cmd_map.keys():
        print("sub command: %s not found" % tgt)
        return False

    global g_target
    global g_params

    g_target = tgt
    g_params = sys.argv[2:]
    return True


def fan_ctrl_main():
    if not parse_args():
        print_usage()
        exit(-100)

    try:
        ret = g_cmd_map[g_target]["func"](g_params)
        if ret != ERR_NONE:
            if ret == ERR_PARAM:
                print("Failed, usage: %s" % g_cmd_map[g_target]["help"])
            else:
                print("Failed: fan-ctrl %s, result %s" % (g_target, result_string[-ret]))
            exit(ret)
    except Exception as e:
        print("fan-ctrl %s failed: %s %s" \
              % (g_target, str(e), traceback.format_exc()))
        exit(-101)

    exit(0)

if __name__ == "__main__":
    fan_ctrl_main()
