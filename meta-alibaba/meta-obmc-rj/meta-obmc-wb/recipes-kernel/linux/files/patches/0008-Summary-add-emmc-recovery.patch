diff --git a/drivers/mmc/core/mmc_ext.c b/drivers/mmc/core/mmc_ext.c
new file mode 100644
index 000000000..5fde03109
--- /dev/null
+++ b/drivers/mmc/core/mmc_ext.c
@@ -0,0 +1,301 @@
+/*
+ *  mmc-ext.c - mmc ext routines module
+ *
+ *  created by: 
+ *
+ */
+/*
+ * mmc-ext.c -  mmc ext routines module:
+ *                    1) low-level driver operations
+ *                    2) bsp module extern operations
+ *                    3) diagnose cdev driver operations
+ *
+ * Copyright 2022
+ *
+ * This file is released under the GPLv2.
+*/
+
+#include <linux/kernel.h>
+#include <linux/io.h>
+#include "mmc_ext.h"
+extern storage_resume_record_log_t emmc_info;
+extern struct atomic_notifier_head wb_emmc_logging_notifier_list;
+
+typedef int (*mmc_reset_func_t)(u32, u32);
+
+struct mmc_bsp_operations {
+	mmc_reset_func_t   bsp_power_reset_fn;
+};
+
+struct mmc_bsp_operations mmc_bsp_ops;
+
+#define MMC_BSP_OPS_POWER_RESET (mmc_bsp_ops.bsp_power_reset_fn)
+
+/**
+ *	mmc_resume_init
+ *	int
+ *
+ *	bsp call to init
+ *
+ *	RETURNS:
+ *	0 on success, others on failure.
+ */
+int mmc_resume_init(void)
+{
+	printk(KERN_DEBUG "mmc resume init! \n");
+
+	MMC_BSP_OPS_POWER_RESET = NULL;
+
+	return 0;
+}
+
+EXPORT_SYMBOL(mmc_resume_init);
+/**
+ *	mmc_resume_destroy
+ *	int
+ *
+ *	bsp call to destory
+ *
+ *	RETURNS:
+ *	0 on success, others on failure.
+ */
+int mmc_resume_destroy(void)
+{
+	printk(KERN_DEBUG "destroy mmc resume interface! \n");
+
+	MMC_BSP_OPS_POWER_RESET = NULL;
+
+	return 0;
+}
+
+EXPORT_SYMBOL(mmc_resume_destroy);
+
+/**
+ *	sdchi_mmc_power_reset
+ *	void
+ *
+ *	mmc interface for emmc power reset
+ *
+ *	RETURNS:
+ *	0 on success, others on failure.
+ */
+int mmc_hw_reset_bsp(u32 dev_type, u32 slot_id)
+{
+	int rc = 0;
+	mmc_reset_func_t bsp_reset;
+    int logth = 0;
+
+	printk(KERN_DEBUG "mmc: bsp reset start.\n");
+    emmc_info.power_reset_num++;
+    memset(emmc_info.resume_pri_logging, 0, RESUME_PRINTF_LOG_LENGTH_MAX);
+	bsp_reset = MMC_BSP_OPS_POWER_RESET;
+
+	if (NULL != bsp_reset) {
+		rc = bsp_reset(dev_type, slot_id);
+	} else {
+		printk(KERN_DEBUG "mmc: the interface of emmc-resume is not registered! \n");
+        logth = strlen(emmc_info.resume_pri_logging);
+        snprintf(emmc_info.resume_pri_logging + logth, RESUME_PRINTF_LOG_LENGTH_MAX - logth -1,
+                    "mmc: the interface of emmc-resume is not registered! \n");
+		rc = -99;
+	}
+
+	if (rc != 0) {
+        logth = strlen(emmc_info.resume_pri_logging);
+		printk(KERN_DEBUG "mmc: bsp reset failed.\n");
+        snprintf(emmc_info.resume_pri_logging + logth, RESUME_PRINTF_LOG_LENGTH_MAX - logth -1,
+                                                        "mmc: bsp reset failed.\n");
+	} else {
+		printk(KERN_DEBUG "mmc: bsp reset succeed.\n");
+        logth = strlen(emmc_info.resume_pri_logging);
+        snprintf(emmc_info.resume_pri_logging + logth, RESUME_PRINTF_LOG_LENGTH_MAX - logth -1,
+                                                        "mmc: bsp reset succeed.\n");
+	}
+
+	return rc;
+}
+
+EXPORT_SYMBOL(mmc_hw_reset_bsp);
+
+/**
+ *	mmc_resume_register
+ *	@pwr_reset: reset_handle
+ *
+ *	bsp call to regist  reset fn
+ *
+ *	RETURNS:
+ *	0 on success, others on failure.
+ */
+int mmc_resume_register(mmc_reset_func_t reset_handle)
+{
+	printk(KERN_DEBUG "bsp register power_reset_handle!\n");
+
+	MMC_BSP_OPS_POWER_RESET = reset_handle;
+
+	return 0;
+}
+
+EXPORT_SYMBOL(mmc_resume_register);
+/**
+ *	mmc_resume_unregister
+ *	int
+ *
+ *	bsp call to destory
+ *
+ *	RETURNS:
+ *	0 on success, others on failure.
+ */
+int mmc_resume_unregister(void)
+{
+	MMC_BSP_OPS_POWER_RESET = NULL;
+
+	printk(KERN_DEBUG "unregister mmc resume interface! \n");
+
+	return 0;
+}
+
+EXPORT_SYMBOL(mmc_resume_unregister);
+
+static storage_resume_record_log_list_t record_info;
+void emmc_get_current_time(storage_resume_record_log_t *time_info);
+
+static int wb_emmc_notifier(struct notifier_block *nb, unsigned long val, void *data)
+{
+    storage_resume_record_log_t *tmp_info = (storage_resume_record_log_t *)data;
+    int i;
+
+    i = val % RESUME_RECORD_INFO_MAX_STORE;
+
+    emmc_get_current_time(&record_info.resume_record_info[i]);
+    record_info.resume_record_info[i].init_reset_num = tmp_info->init_reset_num;
+    record_info.resume_record_info[i].ata_comreset_num = tmp_info->ata_comreset_num;
+    record_info.resume_record_info[i].power_reset_num = tmp_info->power_reset_num;
+    memcpy(record_info.resume_record_info[i].resume_pri_logging, tmp_info->resume_pri_logging,
+                                RESUME_PRINTF_LOG_LENGTH_MAX - 1);
+
+    return NOTIFY_DONE;
+}
+
+static struct notifier_block wb_emmc_dec = {
+    .notifier_call  = wb_emmc_notifier,
+    .priority       = INT_MAX,
+};
+
+static void wb_emmc_error_notifier_register(void)
+{
+    atomic_notifier_chain_register(&wb_emmc_logging_notifier_list, &wb_emmc_dec);
+
+}
+
+static void wb_emmc_error_notifier_unregister(void)
+{
+    atomic_notifier_chain_unregister(&wb_emmc_logging_notifier_list, &wb_emmc_dec);
+
+}
+
+static ssize_t emmc_logging_show(struct kobject *kobj, struct kobj_attribute *attr,char *buf)
+{
+    char timebuf[RESUME_PRINTF_LOG_LENGTH_MAX];
+    int i = 0, lenth = 0, logth = 0;
+
+    for(i = 0; i < RESUME_RECORD_INFO_MAX_STORE; i++) {
+        if (record_info.resume_record_info[i].resume_pri_logging[0] != 0) {
+            memset(timebuf, 0, RESUME_PRINTF_LOG_LENGTH_MAX);
+            lenth = snprintf(timebuf, RESUME_PRINTF_LOG_LENGTH_MAX - 1, "== %ld-%d-%d-%d:%d:%d ==\n",
+                        record_info.resume_record_info[i].timestamp.tm_year,
+                        record_info.resume_record_info[i].timestamp.tm_mon,
+                        record_info.resume_record_info[i].timestamp.tm_mday,
+                        record_info.resume_record_info[i].timestamp.tm_hour,
+                        record_info.resume_record_info[i].timestamp.tm_min,
+                        record_info.resume_record_info[i].timestamp.tm_sec);
+
+            lenth += snprintf(timebuf + lenth, RESUME_PRINTF_LOG_LENGTH_MAX - lenth - 1,
+                    "Storage Resume Count:\ninit_reset_num   comreset_num   power_reset_num \n      %-10d     %-15d     %-15d\n",
+                            record_info.resume_record_info[i].init_reset_num,
+                            record_info.resume_record_info[i].ata_comreset_num,
+                            record_info.resume_record_info[i].power_reset_num);
+            lenth += snprintf(timebuf + lenth, RESUME_PRINTF_LOG_LENGTH_MAX - lenth - 1, "Resume Logging Detail:\n%s\n",
+                            record_info.resume_record_info[i].resume_pri_logging);
+
+            logth += snprintf(buf + logth, PAGE_SIZE - logth - 1, "%s", timebuf);
+        }
+    }
+
+	return logth;
+}
+
+
+static struct kobj_attribute err_logging_attribute        = __ATTR(err_logging, S_IRUGO, emmc_logging_show, NULL);
+
+static struct attribute *emmc_attrs[] = {
+		&err_logging_attribute.attr,
+		NULL, /* need to NULL terminate the list of attributes */
+};
+
+static struct attribute_group attr_group = {
+.attrs = emmc_attrs,
+};
+
+static struct kobject *emmc_kobj;
+
+int wb_emmc_logging_sysfs_init(void)
+{
+	int retval;
+
+	/*
+	  * Create a simple kobject with the name of "kobject_example",
+	  * located under /sys/kernel/
+	  *
+	  * As this is a simple directory, no uevent will be sent to
+	  * userspace.  That is why this function should not be used for
+	  * any type of dynamic kobjects, where the name and number are
+	  * not known ahead of time.
+	*/
+	emmc_kobj = kobject_create_and_add("emmc_log", kernel_kobj);
+	if (!emmc_kobj) {
+        pr_err("creat emmc_log kobj fail\n");
+	    return -ENOMEM;
+    }
+
+	/* Create the files associated with this kobject */
+	retval = sysfs_create_group(emmc_kobj, &attr_group);
+	if (retval) {
+        pr_err("creat emmc_log sysfs fail, ret: %d\n", retval);
+	    kobject_put(emmc_kobj);
+        return retval;
+    }
+
+	wb_emmc_error_notifier_register();
+    pr_info("emmc logging sysfs init success\n");
+	return retval;
+}
+
+EXPORT_SYMBOL(wb_emmc_logging_sysfs_init);
+
+
+void wb_emmc_logging_sysfs_exit(void)
+{
+	kobject_put(emmc_kobj);
+	wb_emmc_error_notifier_unregister();
+    pr_info("emmc logging sysfs exit success\n");
+}
+EXPORT_SYMBOL(wb_emmc_logging_sysfs_exit);
+
+void emmc_get_current_time(storage_resume_record_log_t *time_info)
+{
+    struct timespec64 tv;
+    struct rtc_time tm;
+
+    ktime_get_real_ts64(&tv);
+    rtc_time64_to_tm(tv.tv_sec, &tm);
+
+    time_info->timestamp.tm_year = tm.tm_year + 1900;
+    time_info->timestamp.tm_mon = tm.tm_mon + 1;
+    time_info->timestamp.tm_mday = tm.tm_mday;
+    time_info->timestamp.tm_hour = tm.tm_hour;
+    time_info->timestamp.tm_min = tm.tm_min;
+    time_info->timestamp.tm_sec = tm.tm_sec;
+
+    return;
+}
+EXPORT_SYMBOL(emmc_get_current_time);
