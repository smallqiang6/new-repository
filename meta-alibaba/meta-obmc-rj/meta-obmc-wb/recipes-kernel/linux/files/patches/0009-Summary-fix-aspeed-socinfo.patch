From 573d0c2e080b2fddaea0be6a4deb16fecd35c9e9 Mon Sep 17 00:00:00 2001
From: luohao <luoh@ruijie.com.cn>
Date: Thu, 12 Dec 2024 17:40:04 +0800
Subject: [PATCH] Summary:(fix aspeed socinfo)

BranchName: facebook-meta-whitebox-master
CAFID: N202412120805
BUGID: 1272335
WorkPackageName: BSP
The ratio of self research code(0~1): 1

Change-Id: Ibac5f725c270bf9f4a5029fb4356141c943c5371
---
 drivers/soc/aspeed/aspeed-socinfo.c | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/drivers/soc/aspeed/aspeed-socinfo.c b/drivers/soc/aspeed/aspeed-socinfo.c
index 1ca140356..bf90898dc 100644
--- a/drivers/soc/aspeed/aspeed-socinfo.c
+++ b/drivers/soc/aspeed/aspeed-socinfo.c
@@ -9,10 +9,14 @@
 #include <linux/slab.h>
 #include <linux/sys_soc.h>
 
+#define ASPEED_SOC_ID_MASK (0xFF00FFFF)
+
 static struct {
 	const char *name;
 	const u32 id;
-} const rev_table[] = {
+}
+
+const rev_table[] = {
 	/* AST2400 */
 	{ "AST2400", 0x02000303 },
 	{ "AST1400", 0x02010103 },
@@ -31,11 +35,11 @@ static struct {
 
 static const char *siliconid_to_name(u32 siliconid)
 {
-	unsigned int id = siliconid & 0xff00ffff;
+	unsigned int id = siliconid & ASPEED_SOC_ID_MASK;
 	unsigned int i;
 
 	for (i = 0 ; i < ARRAY_SIZE(rev_table) ; ++i) {
-		if (rev_table[i].id == id)
+		if (((rev_table[i].id) & ASPEED_SOC_ID_MASK) == id)
 			return rev_table[i].name;
 	}
 
@@ -137,13 +141,14 @@ static int __init aspeed_socinfo_init(void)
 
 	soc_dev = soc_device_register(attrs);
 	if (IS_ERR(soc_dev)) {
+		kfree(attrs->machine);
 		kfree(attrs->soc_id);
 		kfree(attrs->serial_number);
 		kfree(attrs);
 		return PTR_ERR(soc_dev);
 	}
 
-	pr_info("ASPEED %s rev %s (%s)\n",
+	pr_info("SOC: ASPEED %s-%s (%s)\n",
 			attrs->family,
 			attrs->revision,
 			attrs->soc_id);
-- 
