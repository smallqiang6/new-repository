+	u8 *np_buff = rsa_engine->rsa_buff + ASPEED_RSA_NP_BUFF;
+
+	RSA_DBG("\n");
+#if 0
+	printk("rsa_buff: \t%x\n", rsa_engine->rsa_buff);
+	printk("xa_buff: \t%x\n", xa_buff);
+	printk("e_buff: \t%x\n", e_buff);
