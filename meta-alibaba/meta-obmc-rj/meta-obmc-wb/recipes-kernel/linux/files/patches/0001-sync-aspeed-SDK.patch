+#define  HACE_CMD_OP_INDEPENDENT	(0x1)
+#define ASPEED_HACE_GCM_ADD_LEN		0x14 //G6
+#define ASPEED_HACE_TAG			0x18 //G5
+#define ASPEED_HACE_GCM_TAG_BASE_ADDR	0x18 //G6
+#define ASPEED_HACE_STS			0x1C
