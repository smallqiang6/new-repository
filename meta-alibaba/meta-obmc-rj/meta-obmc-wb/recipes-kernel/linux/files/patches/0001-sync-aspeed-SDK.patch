+void print_buf(const void *buf, int len)
+{
+	int i;
+	const u8 *_buf = buf;
+
+	for (i = 0; i < len; i++) {
+		if (i % 0x10 == 0)
+			printk(KERN_CONT "%05x: ", i);
+		printk(KERN_CONT "%02x ", _buf[i]);
