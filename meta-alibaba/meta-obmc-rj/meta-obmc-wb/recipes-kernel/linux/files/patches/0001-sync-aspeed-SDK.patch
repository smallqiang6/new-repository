+
+static int aspeed_sham_export(struct ahash_request *req, void *out)
+{
+	struct aspeed_sham_reqctx *rctx = ahash_request_ctx(req);
+
+	AHASH_DBG("rctx->bufcnt %d\n", rctx->bufcnt);
+
+	memcpy(out, rctx, sizeof(*rctx));
+	return 0;
+}
