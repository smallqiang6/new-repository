+	i3cmux@f {
+		compatible = "eeprom";
+		reg = <0xf 0x0 0x00000000>;
+	};
+
+	JESD300_SPD_I2C_MODE(3, 0, 52);
+	JESD300_SPD_I2C_MODE(3, 1, 53);
+};
