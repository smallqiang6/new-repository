 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/reset.h>
@@ -540,6 +541,9 @@ static int aspeed_sdhci_probe(struct platform_device *pdev)
 	struct resource *res;
 	int slot;
 	int ret;
+	u32 reset_gpio;
+	u32 reset_on;
+	u32 reset_off;
 
 	aspeed_pdata = of_device_get_match_data(&pdev->dev);
 	if (!aspeed_pdata) {
@@ -605,6 +609,38 @@ static int aspeed_sdhci_probe(struct platform_device *pdev)
 		goto err_pltfm_free;
 	}
 
+	if (of_property_read_u32(np, "reset_gpio", &reset_gpio)) {
+		reset_gpio = -1;
+		dev_info(&pdev->dev, "of property read reset_gpio failed.\n");
+	} else {
+		if (of_property_read_u32(np, "reset_on", &reset_on)) {
+			dev_err(&pdev->dev, "of property read reset_on failed.\n");
+			ret = -EINVAL;
+			goto err_sdhci_add;
+		}
+
+		if (of_property_read_u32(np, "reset_off", &reset_off)) {
+			dev_err(&pdev->dev, "of property read reset_off failed.\n");
+			ret = -EINVAL;
+			goto err_sdhci_add;
+		}
+
+		dev_info(&pdev->dev, "reset_gpio[%d],reset_on[%d],reset_off[%d].\n", reset_gpio, reset_on, reset_off);
+
+		if (!gpio_is_valid(reset_gpio)) {
+			dev_err(&pdev->dev, "reset_gpio[%d] invalid \n", reset_gpio);
+			ret = -EINVAL;
+			goto err_sdhci_add;
+		}
+
+		ret = gpio_request(reset_gpio, "eMMC_reset");
+		if (ret < 0) {
+			dev_err(&pdev->dev, "request GPIO[%d] error ret[%d]  \n", reset_gpio, ret);
+			goto err_sdhci_add;
+		}
+		gpio_direction_output(reset_gpio, reset_off);
+	}
+
 	ret = mmc_of_parse(host->mmc);
 	if (ret)
 		goto err_sdhci_add;
