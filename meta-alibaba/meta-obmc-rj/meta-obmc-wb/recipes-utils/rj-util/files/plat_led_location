function led_help()
{
  echo "    USAGE: $0 option
     e.g.: $0 on/off/status
       on: open location led
      off: close location led
   status: display the status of location led"
  exit 1
}

function led_result()
{
  result_status=$($(which bmc.sh) port led status)
  result_tmp=${result_status:0:1}
  case $result_tmp in
    0)
      echo "Unsuport location led"
      exit 1
    ;;
    1 | 3 | 4 | 5)
      if [ $1 == 1 ]; then
        echo "Operation done, location LED is OFF"
      else
        echo "Operation failed, location LED is OFF"
        exit 1
      fi
    ;;
    2)
      if [ $1 == 1 ]; then
        echo "Operation done, location LED is ON"
      else
        echo "Operation failed, location LED is ON"
        exit 1
      fi
    ;;
    *)
      if [ $1 == 1 ]; then
        echo "Operation done, location LED status is UNKNOWN" 
      else
        echo "Operation failed, location LED status is UNKNOWN"
      fi
      exit 1
    ;;
  esac
}

function led_on()
{
  status=0
  $(which bmc.sh) port led location
  if [ $? == 0 ] ; then
    status=1
  fi
  led_result $status
}

function led_off()
{
  status=0
  $(which bmc.sh) port led recover
  if [ $? == 0 ] ; then
    status=1
  fi
  led_result $status
}

function led_status()
{
  result_status=$($(which bmc.sh) port led status)
  result_tmp=${result_status:0:1}
  case $result_tmp in
    0)
      echo "Unsuport location led"
      exit 1
    ;;
    1 | 3 | 4 | 5)
      echo "Location LED is OFF"
    ;;
    2)
      echo "Location LED is ON"
    ;;
    *)
      echo "Operation failed, current location LED status is UNKNOWN" 
      exit 1
    ;;
  esac
}

case $1 in
  "on")
    led_on
  ;;
  "off")
    led_off
  ;;
  "status")
    led_status
  ;;
  *)
    led_help
  ;; # help
esac
