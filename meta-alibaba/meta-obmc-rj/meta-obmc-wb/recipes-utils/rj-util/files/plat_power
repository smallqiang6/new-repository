  read on
  if [[ "$on"x != "y"x ]] && [[ "$on"x != "Y"x ]] ; then
    exit
  fi

  # set cpld
  set_port_on
}

function set_port_on() {
  mac_status=$(read_mac_status)
  mac_value=$(echo $?)
  if [[ $mac_value != 2 && $mac_value != 1 ]]; then
    echo_message "mac power status err, status:$mac_value."
    return 2
  else
    : #pass
  fi

  result_status=$(read_port_status)
  result_value=$(echo $?)
  if [ $result_value == 2 ]; then
    echo "No need to power port."
    return 0
  elif [ $result_value == 1 ]; then #current CPU power status is ON and Operation power on
    echo "Operation done, current port power status is ON."
    return 0
  else
    : #pass
  fi

  result=$(ast_product_func_call enable_host_cpu_power_force_control)
  ret=$?
  if [ $ret != 0 -a $ret != 127 ];then
    echo_message "enable host cpu power force control falied: $ret."
    return 2
  fi
  product_power_on_port
  if [ $? == 0 ]; then
    logger -p DEBUG "PORT Power set on"
    status=1
  fi

  power_result=$(result_port_power $status)
  echo $power_result
  if [[ $power_result =~ "ON" && $status == 1 ]]; then
    power_ret=0 #done
  else
    power_ret=2
    echo_message "failed to power on port."
  fi

  result=$(ast_product_func_call disable_host_cpu_power_force_control)
  ret=$?
  if [ $ret != 0 -a $ret != 127 ];then
    echo_message "disable host cpu power force control falied: $ret."
    return 2
  fi
  return $power_ret
}

