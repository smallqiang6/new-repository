. /usr/local/bin/ast-functions

# Determine Whether folder(/var/log/fw) exists
if [ ! -d "/var/log/fw" ]; then
  mkdir /var/log/fw
fi

cpu_last_reset_status="/var/log/fw/cpu_last_reset_status"
status=0
function power_help()
{
  echo "    USAGE: $0 option
     e.g.: $0 cpu on/off/cycle/reset/status
     e.g.: $0 mac on/off/status
     e.g.: $0 port on/off/status
     e.g.: $0 machine cycle
     e.g.: $0 bmc-emmc cycle
     e.g.: $0 cpu-emmc cycle
     e.g.: $0 netcard1/netcard2 on/off/status
       on: power on CPU/MAC/PORT
      off: power off CPU/MAC/PORT
    cycle: power off and then power on host cpu/machine/bmc-emmc/cpu-emmc
    reset: reset host cpu
   status: display the power status of CPU/MAC/PORT"
  exit 1
}

function echo_message()
{
  echo "$1"
  logger -p DEBUG "$1"
}

function read_status()
{
  result_status=$(ast_product_func_call cpu_status)
  result_value=$(echo $?)
  return $result_value
}

# Result of power on\off\cycle\reset CPU
function result_power()
{
  result_status=$(read_status)
  result_value=$(echo $?)
  case $result_value in
    0)
      if [ $1 == 1 ]; then
        echo "Operation done, current CPU power status is OFF"
      else
        echo "Operation failed, current CPU power status is OFF"
      fi
    ;;
    1)
      if [ $1 == 1 ]; then
        echo "Operation done, current CPU power status is ON"
      else
        echo "Operation failed, current CPU power status is ON"
      fi
    ;;
    *)
      if [ $1 == 1 ]; then
        echo "Operation done, current CPU power status is UNKNOWN"
      else
        echo "Operation failed, current CPU power status is UNKNOWN"
      fi
    ;;
  esac
}

# CPU current state
function power_status()
{
  result_status=$(read_status)
  result_value=$(echo $?)
  case $result_value in
    0)
      echo "Current CPU power status is OFF"
    ;;
    1)
      echo "Current CPU power status is ON"
    ;;
    *)
      echo "Operation failed, current CPU power status is UNKNOWN" 
    ;;
  esac
}

# Power on cpu, wait 10s before power on cpu
function power_on()
{
  echo -ne "power on cpu [y/n]:"
  read on
  if [[ "$on"x != "y"x ]] && [[ "$on"x != "Y"x ]] ; then
    exit
  fi

  result_status=$(read_status)
  result_value=$(echo $?)
  if [ $result_value == 1 ]; then #current CPU power status is ON and Operation power on
    echo "Operation done, current CPU power status is ON"
    exit 0
  fi
  for i in {1..10}
  do
    echo -n "."
    sleep 1
  done
  echo ""
  ast_product_func_call power_on_cpu
  if [ $? == 0 ]; then
    logger -p DEBUG "plat Power set on"
    status=1
  fi

  power_wait_for_status "ON"
}

#Power off cpu
function power_off()
{
  echo -ne "power off cpu [y/n]:"
  read off
  if [[ "$off"x != "y"x ]] && [[ "$off"x != "Y"x ]] ; then
    exit
  fi

  result_status=$(read_status)
  result_value=$(echo $?)
  if [ $result_value == 0 ]; then #current CPU power status is OFF and Operation power off
    echo "Operation done, current CPU power status is OFF"
    exit 0
  fi

  ast_product_func_call power_off_cpu
  if [ $? == 0 ]; then
    echo "COLD" > $cpu_last_reset_status
    logger -p DEBUG "plat Power set off"
    status=1
  fi
  power_wait_for_status "OFF"
}

#Power cycle cpu, power on and power off
function power_cycle()
{
  echo -ne "power cycle cpu [y/n]:"
  read cycle
  if [[ "$cycle"x != "y"x ]] && [[ "$cycle"x != "Y"x ]] ; then
    exit
  fi

  restult=$(ast_product_func_call get_support_capability power_cycle_cpu)
  capability=$?
  if [ $capability == 1 ];then
    restult=$(ast_product_func_call power_cycle_cpu)
    ret=$?
    if [ $ret != 0 ];then
      logger -p DEBUG "power_cycle_cpu failed: $restult"
      status=0
      result_power $status
      exit
    fi
  else
    ast_product_func_call power_off_cpu
    for i in {1..10}
    do
      echo -n "."
      sleep 1
    done
    echo ""
    ast_product_func_call power_on_cpu
    ret=$?
  fi

  if [ $ret == 0 ]; then
    echo "COLD" > $cpu_last_reset_status
    logger -p DEBUG "plat Power set cycle"
    status=1
  fi
  
  power_wait_for_status "ON"
}

#Power reset cpu, power on and power off
function power_reset()
{
  echo -ne "power reset cpu [y/n]:"
  read reset
  if [[ "$reset"x != "y"x ]] && [[ "$reset"x != "Y"x ]] ; then
    exit
  fi

  ast_product_func_call power_reset_cpu
  if [ $? == 0 ]; then
    echo "WARM" > $cpu_last_reset_status
    logger -p DEBUG "plat Power set reset"
    status=1
  fi

  power_wait_for_status "ON"
}

function power_wait_for_status()
{
  wait_for_status=$1
  for i in {1..20}
  do
    sleep 1
    current_status=$(result_power $status)
    if [[ $current_status =~ $wait_for_status ]]; then
      break
    fi
  done
  echo $current_status
}

function power()
{
  case $1 in
    "on")
      power_on
    ;;
    "off")
      power_off
      ast_backup_to_single_data $cpu_last_reset_status
    ;;
    "cycle")
      power_cycle
      ast_backup_to_single_data $cpu_last_reset_status
    ;;
    "reset")
      power_reset
      ast_backup_to_single_data $cpu_last_reset_status
    ;;
    "status")
      power_status
    ;;
    *)
      power_help
    ;; # help
  esac
}

