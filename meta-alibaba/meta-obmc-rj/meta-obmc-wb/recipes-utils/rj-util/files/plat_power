    exit
  fi

  result_status=$(read_mac_status)
  result_value=$(echo $?)
  if [ $result_value == 2 ]; then
    echo "unspport this function"
    exit 0
  elif [ $result_value == 0 ]; then #current CPU power status is OFF and Operation power off
    echo "Operation done, current MAC power status is OFF"
    exit 0
  else
    : #pass
  fi

  product_power_port_with_mac
  if [ $? -eq 1 ]; then
    # The port will not be powered off following the mac, and the operation is required
    set_port_log=$(set_port_off)
    if [ $? -eq 2 ]; then
      # failed to power off port
      echo $set_port_log
    fi
  fi

  result=$(ast_product_func_call enable_host_cpu_power_force_control)
  ret=$?
  if [ $ret != 0 -a  $ret != 127 ];then
    logger -p DEBUG "enable host cpu power force control falied: $ret"
    echo "enable host cpu power force control falied: $ret"
    exit 0
  fi
  product_power_off_mac
  if [ $? == 0 ]; then
    logger -p DEBUG "MAC Power set off"
    status=1
  fi

  result_log=$(result_mac_power $status)
  echo $result_log
  result=$(ast_product_func_call disable_host_cpu_power_force_control)
  ret=$?
  if [ $ret != 0 -a  $ret != 127 ];then
    logger -p DEBUG "disable host cpu power force control falied: $ret"
    echo "disable host cpu power force control falied: $ret"
  fi
}

