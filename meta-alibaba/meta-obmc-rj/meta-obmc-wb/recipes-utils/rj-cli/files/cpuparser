def parse_mce_ierr_err(data, name, dict_info, dict_mc, err_type):
    try :
        output = ""
        if (name in data) and (len(data[name].split(" ")) > 0):
            tmp_value = hex_to_bin_bit(data[name].split(" "), name)
        else:
            output = "%s does not exist, or no data" % name
            print(output)
            return
        if int(tmp_value[8], 2):
            output = err_type + " : "
            core_type = tmp_value[0:8][::-1]
            if core_type in dict_info:
                output = output + dict_info[core_type]
                print(output)
                core_type = dict_info[core_type]
                if core_type != "IIO" : # "IIO" need to next parse
                    parse_mce_bank_msb(data, dict_mc[core_type])
                else:
                    print(output)
    except Exception as e:
        print(output + "Resolve mce-ierr err type  failed: %s" % str(e))

#MCE: parse mce ierr form a4(ierr) a8(mce)
def parse_mce_ierr(data):
    """
    1.CPU has four cores(core[0:3])
    2.FirstIerrSrcId or FirstMCerrSrcId bite[0:7] to judge core type
    bit 8: FirstIerrSrcValid - a4
    bit 8: FirstMCerrSrcValid -a8
    """
    dict_info = {
                "10000000" : "CORE0", "10000100" : "CORE1", "10001000" : "CORE2", "10001100" : "CORE3",
                "01000100" : "PCU",   "00000001" : "IMC_CH0", "00000101" : "IMC_CH1", "00000110": "IMC_BOTH",
                "00111100" : "HA", "01111110": "IIO"
           }
    dict_mc = { "CORE0" : ["CORE0MC0STATUS", "CORE0MC1STATUS", "CORE0MC2STATUS", "CORE0MC3STATUS"],
                "CORE1" : ["CORE1MC0STATUS", "CORE1MC1STATUS", "CORE1MC2STATUS", "CORE1MC3STATUS"],
                "CORE2" : ["CORE2MC0STATUS", "CORE2MC1STATUS", "CORE2MC2STATUS", "CORE2MC3STATUS"],
                "CORE3" : ["CORE3MC0STATUS", "CORE3MC1STATUS", "CORE3MC2STATUS", "CORE3MC3STATUS"],
                "PCU" : ["CORE0MC4STATUS"],
                "IMC_BOTH" : ["CORE0MC9STATUS", "CORE0MC10STATUS"],
                "IMC_CH0" : ["CORE0MC9STATUS"],
                "IMC_CH1" : ["CORE0MC10STATUS"],
                "HA" : ["CORE0MC7STATUS"],
        }
    dict_D1533_core = {"10010000" : "CORE4", "10010100" : "CORE5"}
    dict_D1533_info = {
                "CORE4" : ["CORE4MC0STATUS", "CORE4MC1STATUS", "CORE4MC2STATUS", "CORE4MC3STATUS"],
                "CORE5" : ["CORE5MC0STATUS", "CORE5MC1STATUS", "CORE5MC2STATUS", "CORE5MC3STATUS"],
        }
    # parse "a4" ---ierr
    # parse "a8" ---mce
    output = ""
    ret = get_product_core_num()
    if ret == CPU_D1533_CORE_NUM:
        dict_mc = dict(dict_mc, **dict_D1533_info)
        dict_info = dict(dict_info, **dict_D1533_core)
    dict_mce_ierr = {"a4" : "IERR", "a8" : "MCE"}
    try:
        for name in dict_mce_ierr:
            parse_mce_ierr_err(data, name, dict_info, dict_mc, dict_mce_ierr[name])
    except Exception as e:
        output = output + "Resolve IERR or MCE failed: %s" % str(e)
        print(output)

