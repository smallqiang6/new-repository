            output = output + "IFU_ADDR_LSB(5:0) : " + ret_value[0:6][::-1]
        return output
    except Exception as e:
        print("Parse mce misc mc0 returned: %s" % str(e))

def parse_mce_misc_addr(data, name):
    # MC2 - Reserved, does not need to parse
    core_mc0 = ["CORE0MC0MISC", "CORE1MC0MISC", "CORE2MC0MISC", "CORE3MC0MISC", "CORE4MC0MISC", "CORE5MC0MISC"]
    core_mc1 = ["CORE0MC1MISC", "CORE1MC1MISC", "CORE2MC1MISC", "CORE3MC1MISC", "CORE4MC1MISC", "CORE5MC1MISC"]
    core_mc3 = ["CORE0MC3MISC", "CORE1MC3MISC", "CORE2MC3MISC", "CORE3MC3MISC", "CORE4MC3MISC", "CORE5MC3MISC"]
    core_mc4 = ["CORE0MC4MISC"]
    core_mc7 = ["CORE0MC7MISC"]
    core_mc9_10 = ["CORE0MC9MISC", "CORE0MC10MISC"]
    core_mc17_18_19 = ["CORE0MC17MISC", "CORE0MC18MISC", "CORE0MC19MISC"]
    output = ""
    try:
        if name in core_mc0:
            output = parse_mce_misc_mc0_addr(data, name)
        elif name in core_mc1:
            output = parse_mce_misc_mc1_addr(data, name)
        elif name in core_mc3:
            output = parse_mce_misc_mc3_addr(data, name)
        elif name in core_mc4:
            output = parse_mce_misc_mc4_addr(data, name)
        elif name in core_mc7:
            output = parse_mce_misc_mc7_addr(data, name)
        elif name in core_mc9_10:
            output = parse_mce_misc_mc9_10_addr(data, name)
        elif name in core_mc17_18_19:
            output = parse_mce_misc_mc17_18_19_addr(data, name)
        else:
            output = "%s Unknown" % name
        return output
    except Exception as e:
        print("Parse mce misc addr Exception returned: %s" % str(e))

