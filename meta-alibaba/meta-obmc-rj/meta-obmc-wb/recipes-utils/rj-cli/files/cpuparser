"""
1. 1:D30:F2 read register 0xEC, determine the CPU error type
2. 1:D16:F5 read register 0xa4, 0xa8, cpu error(IERR|MCE)
"""

def usage():
    print("usage:")
    print("    cpuparser mce|peci")
    exit()

def get_device_name(path):
    device_name = None
    if not os.path.isfile(path):
        print("%s does not exist" % path)
        exit()
    with open(path) as machine_file:
        for line in machine_file:
            device_name = line.strip()
            break
    return device_name

"""
1. D1527(as23-32, as23-48, as23-128)
2. D1527:CPU 4 core
3. D1533(as14-40d, as14-128,as24-128d)
4. D1533:CPU 6 core
5. return 1 for D1533, return 0 for D1527
6. D1734(AS14-24D8Q, AS25-128Q)
7. D1734:CPU 8 core
"""
def get_product_core_num():
    D1533_list = ["AS14-40D", "AS14-128H", "AS24-128D", "AC51-48C2G", "AS15-20D4M", "AS24-128D-2-RJ"]
    D1734_list = ["AS14-24D8Q", "AS25-128Q", "AS51-24D", "AS15-40Q"]
    fullproductname_list = ["AS24-128D-2-RJ"]
    global g_mce_type
    product_name = get_device_name(PRODUCT_NAME_PATH)
    if product_name == None:
        print("Read product name failed")
        exit()
    fullproduct_name = get_device_name(FULLPRODUCT_NAME_PATH)
    if fullproduct_name == None:
        print("Read fullproduct name failed")
        exit()
    if fullproduct_name in fullproductname_list:
        product_name = fullproduct_name

    if product_name in D1533_list:
        return CPU_D1533_CORE_NUM
    elif product_name in D1734_list:
        g_mce_type = 1
        return CPU_D1734_CORE_NUM
    else:
        return 0

# hex convert to binary
def hex_to_bin_bit(ret_out, name):
    try:
        bin_bit = ""
        if len(ret_out) == 4 or len(ret_out) == 8:
            for k in ret_out:
                ret = int(k, 16)
                ret_value = '{:08b}'.format(ret)
                bin_bit = bin_bit + ret_value[::-1]
        else:
            print("%s : no data(%s) need to convert to binary" % (name, ret_out))
            exit()
        return bin_bit
    except Exception as e:
        print("hex convert to binary failed : " + str(e))
        exit()

# MCE:
# read B1:D30:F2 offset: 0xEC, to verify Caterr err
# return 1: offset ec does not exis, or no data
def parse_mce_err_type(data):
    """
    bite 31:CATERR
    bite 30:IERR
    bite 29:MCERR
    bite 28:CATERR_INTERNAL
    bite 27:IERR_INTERNAL
    bite 26:MCERR_INTERNAL
    """
    output = ""
    try:
        dict_err = {31 : "CATERR :", 30 : "IERR :", 29 : "MCERR :",
                    28 : "CATERR_INTERNAL :", 27 : "IERR_INTERNAL :", 26 : "MCERR_INTERNAL : "}
        if ("ec" in data) or (len(data["ec"].split(" ")) > 0):
            tmp_value = hex_to_bin_bit(data["ec"].split(" "), "ec")
            for k in dict_err:
                if int(tmp_value[k], 2):
                    output = output + dict_err[k]
            return output
        else:
            print("Unknown cpu err type")
            return 1
    except Exception as e:
        print("Resolve CPU type error failed : " + str(e))

# MCE: parse MSCOD bit 16-31
def parse_core_mc_mscod(ret_value, mc, dict):
    output = ""
    try:
        mc_list = ["MC0", "MC1", "MC2", "MC3", "MC7", "MC9", "MC10", "MC17", "MC18", "MC19"]
        if mc in mc_list:
            tmp_value = int(ret_value[16:32][::-1], 2)
            tmp_ret = dict[mc]["MSCOD"].get(tmp_value)
            if tmp_ret != None:
                output = output + "MSCOD : " + tmp_ret + " : "
        if mc == "MC4":
            tmp_value = int(ret_value[24:32][::-1], 2)
            tmp_put = dict[mc]["MSEC_FW"].get(tmp_value)
            if tmp_put != None:
                output = output + "MSEC_FW : " + tmp_put + " : "
            tmp_value = int(ret_value[22], 2)
            if tmp_value:
                tmp_ret = dict[mc]["MSEC_HW"].get(tmp_value)
                if tmp_ret != None:
                    output = output + "MSEC_HW : " + tmp_ret + " : "
            if int(ret_value[16:18][::-1], 2):
                tmp_result = dict[mc]["MSEC_UC"].get(1)
                if tmp_result != None:
                    output = output + "MSEC_UC : " + tmp_result + " : "
        return output
    except Exception as e:
        output = output + "Resolve MSCOD failed: %s" % str(e)
        print(output)

# MCE: parse MCACOD bit 0-15
def parse_core_mc_mcacod(ret_value, mc, dict):
    output = ""
    try:
        cache_err = ["MC0", "MC1", "MC3", "MC17", "MC18", "MC19"]
        imc_err = ["MC9", "MC10"]
        if mc in cache_err:
            tmp_value = int(ret_value[8], 2)
            if tmp_value:
                tmp_ret = dict[mc]["MCACOD"].get(tmp_value)
                if tmp_ret != None:
                    output = output + "MCACOD : " + tmp_ret + " : "
                else:
                    return output
                ret = int(ret_value[4:8][::-1], 2)
                tmp_ret = dict[mc]["MCACOD-1"].get(ret)
                if tmp_ret != None:
                    output = output + tmp_ret + " : "
                ret = int(ret_value[2:4][::-1], 2)
                tmp_ret = dict[mc]["MCACOD-2"].get(ret)
                if tmp_ret != None:
                    output = output + tmp_ret + ":"
                ret = int(ret_value[0:2][::-1], 2)
                tmp_ret = dict[mc]["MCACOD-3"].get(ret)
                if tmp_ret != None:
                    output = output + tmp_ret + " : "
        elif mc in imc_err:
            tmp_value = int(ret_value[7], 2)
            if tmp_value:
                tmp_put =dict[mc]["MCCOD"].get(tmp_value)
                if tmp_put != None:
                    output = output + "MCACOD : " + tmp_put + " : "
                tmp_value = int(ret_value[4:7][::-1], 2)
                tmp_put =dict[mc]["MCCOD-1"].get(tmp_value)
                if tmp_put != None:
                    output = output + tmp_put + " : "
                ret = int(ret_value[0:4][::-1], 2)
                tmp_put =dict[mc]["MCCOD-2"].get(ret)
                if tmp_put != None:
                    output = output + tmp_put + " : "
                    return output
                tmp_put =dict[mc]["MCCOD-2"].get(0)
                if tmp_put != None:
                    output = output + tmp_put + " : " + ret_value[0:4][::-1]
        elif mc == "MC7":
            tmp_value = int(ret_value[4:8][::-1], 2)
            tmp_ret = dict[mc]["MCCOD"].get(tmp_value)
            if tmp_ret != None:
                output = output + "MCCOD : " + tmp_ret + " : "
            tmp_value = int(ret_value[0:4][::-1], 2)
            tmp_ret = dict[mc]["MCCOD-1"].get(tmp_value)
            if tmp_ret != None:
                output = output + tmp_ret + " : "
        elif mc == "MC4":
            tmp_value = int(ret_value[0:16][::-1], 2)
            tmp_ret = dict[mc]["MCCOD"].get(tmp_value)
            if tmp_ret != None:
                output = output + "MCCOD : " + tmp_ret + " : "
        elif mc == "MC2":
            if int(ret_value[4], 2):
                tmp_ret = dict[mc]["MCACOD"].get(1)
                if tmp_ret != None:
                    output = output + "MCACOD : " + tmp_ret + " : "
                tmp_value = int(ret_value[2:4][::-1], 2)
                tmp_ret = dict[mc]["MCACOD-1"].get(tmp_value)
                if tmp_ret != None:
                    output = output + tmp_ret + " : "
                tmp_value = int(ret_value[0:2][::-1], 2)
                tmp_ret = dict[mc]["MCACOD-2"].get(tmp_value)
                if tmp_ret != None:
                    output = output + tmp_ret + " : "
        else:
            output = output + "%s Unknown" % mc
        return output
    except Exception as e:
        output = output + "Resolve mcacod failed: %s" % str(e)
        print(output)

#MCE : joint misc| addr bit 0-64
def joint_addr(ret_out):
    output = "0x"
    for k in ret_out[::-1]:
        output = output + "%02x" % (int(k, 16))
    return output

def parse_mce_misc_mc17_18_19_addr(data, name):
    """
    bit[63:58] : "RTID"
    bit[51:43] : "ORIGREQ"
    bit[42-38] : "TORID"
    bit[28:24] : COREID-"Core ID associated with the logged error"
    bit23: THREADID-Thread ID associated with the logged error
    bit[18:14] : WAY
    bit[8:6] : ADDRMODE - 010
    bit[5:0] : ADDRLSB
    """
    dict_eq = { "110010011" : "PCIe Request - Write invalidate line : ",
                "110010100" : "PCIe Request - Write invalidate line : ",
                "110011000" : "Cache Line Flush : ",
                "110011100" : "PCIe Request - Invalid to Modify : ",
                "110011110" : "PCIe Request - Read Current : ",
                "111000100" : "Write-back Modify to Invalid : ",
                "111000101" : "Write-back Modify to Exclusive : ",
                "111001000" : "Invalid to Modify Request : ",
                "111100001" : "PCIe Request - Direct Cache Access : ",
                "111100000" : "Special Cycle : ",
                "111100100" : "PCIe Request - NonSnoop Read : ",
                "111100101" : "PCIe Request - NonSnoop Write : ",
                "111100110" : "PCIe Request - NonSnoop Write : ",
                "111110011" : "Unlock : ",
                "111110100" : "Interrupt Acknowledge : ",
                "111110101" : "Port Out (CFC/CF8 type transaction) : ",
                "111110110" : "Floating Point Exception : ",
                "111111000" : "End-of-level triggered Interrupt : ",
                "111111001" : "Interrupt (logically addressed) : ",
                "111111010" : "Interrupt (physically addressed) : ",
                "111111011" : "Interrupt Priority Update : ",
                "111111100" : "Port In (CFC/CF8 type transaction) : ",
                "111111110" : "Split Lock : ",
                "111111111" : "Lock : ",
                "100000000" : "Snoop : ",
                "100000001" : "Snoop : ",
                "100000010" : "Snoop : ",
                "100000100" : "Snoop : ",
                "100001000" : "Snoop : ",
                "100001010" : "Snoop : ",
                "100001111" : "Prefetch Hint : ",
                "010011011" : "LLC Victim (either EWB to memory or Evict Cache-line) : ",
                "110000000" : "Request For Ownership : ",
                "110000001" : "Code Read : ",
                "110000010" : "Data Read : ",
                "110000011" : "Set Monitor : ",
                "110000110" : "Data Read : ",
                "110000111" : "Partial Cacheline Read : ",
                "110001100" : "Write Combine Invalidate Line : ",
                "110001101" : "Write Combine Invalidate Line : ",
                "110001110" : "Uncacheable Read : ",
                "110001111" : "Write Invalidate Line : ",
                "110010000" : "Prefetch - Rquest For ownership : ",
                "110010001" : "Prefetch - Code : ",
                "110010010" : "Prefetch - Data : ",
            }
    output = ""
    try:
        ret_value = hex_to_bin_bit(data, name)
        if int(ret_value[58:], 2):
            output = "RTID(63:58) : " + ret_value[58:] + " : "
        ret = ret_value[43:52][::-1]
        if ret in dict_eq:
            output = output + "ORIGREQ(43:51) : " + dict_eq[ret] + " : "
        if int(ret_value[38:43][::-1], 2):
            output = output + "TORID(38:42) : " + ret_value[38:43][::-1]
        if int(ret_value[24:29][::-1], 2):
            output = output + "COREID(24:28) : " + ret_value[24:29][::-1]
        if int(ret_value[14:19][::-1], 2):
            output = output + "WAY(14:18) : " + ret_value[14:19][::-1]
        if int(ret_value[6:9][::-1], 2) == 2:
            output = output + "ADDRMODE(6:8) : Physical Address : "
        else:
            output = output + "ADDRMODE(6:8) : " + ret_value[6:9][::-1] + " : "
        if int(ret_value[0:6][::-1], 2) == 2:
            output = output + "ADDRLSB(0:5) : " + ret_value[0:6][::-1] + " : "
        return output
    except Exception as e:
        print("Parse mce misc mc17-18-19 Exception returned: %s" % str(e))

def parse_mce_misc_mc9_10_addr(data, name):
    """"
    bit63 : MC logs-second correctable error
    bit62 : MC logs-first correctable error
    bit[55:51] : MC logs the second error failing rank
    bit[50:46] : MC logs the first error failing rank
    bit[45:30] : MC logs the second error bit mask here
    bit[29:14]: MC logs the first error bit mask here
    bit[13:9]: MCWrDataPar error or MCWrBEPar error
    bit[8:6]: ADDR_MODE- 000: Segment Offset
                         001: Linear Address
                         010: Physical (system) Address
                         011: Memory Address
                         111: Generic
    bit[5:0] : REC_ERR_LSB
    """
    dict_addr_mode = {"000" : "Segment Offset : ", "001": "Linear Address : ",
                      "010" : "Physical (system) Address : ", "011": "Memory Address : ",
                      "111" : "Generic : "}
    output = ""
    try:
        ret_value = hex_to_bin_bit(data, name)
        if int(ret_value[63], 2):
            output = "EXTRA_ERR_INFO(63:9) : " + "MC logs-second correctable error : "
            if int(ret_value[51:56][::-1], 2):
                output = output + "MC logs the second error failing rank : " + \
                    ret_value[51:56][::-1] + " : "
            if int(ret_value[30:46][::-1], 2):
                output = output + "MC logs the second error bit mask here : " + \
                    ret_value[30:46][::-1] + " : "
        if int(ret_value[62], 2):
            output = "EXTRA_ERR_INFO : " + "MC logs-first correctable error : "
            if int(ret_value[51:56][::-1], 2):
                output = output + "MC logs the first error failing rank : " + \
                    ret_value[51:56][::-1] + " : "
            if int(ret_value[14:30][::-1], 2):
                output = output + "MC logs the first error bit mask here : " + \
                    ret_value[14:30][::-1] + " : "
        if int(ret_value[9:14][::-1], 2):
            output = output + "MCWrDataPar error or MCWrBEPar error : " + \
                ret_value[9:14][::-1] + ":"
        ret = ret_value[6:9][::-1]
        if ret in dict_addr_mode:
            output = output + "ADDR_MODE(6:8): " + dict_addr_mode[ret]
        if int(ret_value[0:6][::-1], 2):
            output = output + "REC_ERR_LSB(0:5) : " + ret_value[0:6][::-1] + " : "
        return output
    except Exception as e:
        print("Parse mce misc mc9-10 Exception returned: %s" % str(e))

def parse_mce_misc_mc7_addr(data, name):
    """
    bit 51:43 - BTIDTO
    bit 42 - MIRRORCORR
    bit 41 - FAILOVER
    bit 40:39 - HADBBANK 01:Critical half data bank 10: Non-critical half data bank
                11: Both banks
    bit 38:37 - PE 00: low priority, 01: medium priority, 10: high priority 11: critical priority
    bit 34:29 - REQOPCODE:
                34: Read Current Request (RDCUR)
                33: NonSnp Request (NONSNPRD, NONSNPWR0)
                32: Read Data Request (RDDATA, RDDATAMIG)
                31: Write Request (NONSNPWR, WRMTO, ACKCNFLT, ACKCNFLTWBI)
                30: Read Operation (RDCODE, RDDATA, NONSNPRD, RDINVOWN, RDCUR, RDDATAMIG)
                29: Invalidate Operation (INVITOE)
    bit 28:25 - RNID
    bit 22: 17 - RTID
    bit 15: 9 - HTID
    """
    output = ""
    dict_hadbbank = {"01" : "Critical half data bank : ", "10" : "Non-critical half data bank : ",
                     "11" : "Both banks : "}
    list_pe = ["low priority : ", "medium priority : ", "high priority : ", "critical priority : "]
    dict_re = {29: "Invalidate Operation (INVITOE) : ", 30 : "Read Operation (RDCODE, RDDATA, NONSNPRD, RDINVOWN, RDCUR, RDDATAMIG) : ",
               31: "Write Request (NONSNPWR, WRMTO, ACKCNFLT, ACKCNFLTWBI) : ",
               32: "Read Data Request (RDDATA, RDDATAMIG) : ", 33 : "NonSnp Request (NONSNPRD, NONSNPWR0) : ",
               34: "Read Current Request (RDCUR) : "}
    try:
        ret_value = hex_to_bin_bit(data, name)
        if int(ret_value[43:52][::-1], 2):
            output = "BTIDTO(51:43) : " + ret_value[43:52][::-1] + " : "
        if int(ret_value[42], 2):
            output = output + "MIRRORCORR(42) : "
        if int(ret_value[41], 2):
            output = output + "FAILOVER(41) : "
        ret = ret_value[39:41][::-1]
        if ret in dict_hadbbank:
            output = output + "HADBBANK(39:40) : " + dict_hadbbank[ret]
        ret = int(ret_value[37:49][::-1], 2)
        output = output + "PE(37:48) : " + list_pe[ret]
        for k in dict_re:
            if ret_value[k] == "1":
                output = output + "REQOPCODE(34:29): " +  dict_re[k]
        if int(ret_value[25:29][::-1], 2):
            output = output + "RNID(25:28) : " + ret_value[25:29][::-1] + " : "
        if int(ret_value[17:23][::-1], 2):
            output = output + "RTID(22:17) : " + ret_value[17:23][::-1] + " : "
        if int(ret_value[9:16][::-1], 2):
            output = output + "HTID(15:9) : " + ret_value[9:16][::-1] + " : "
        return output
    except Exception as e:
        print("Parse mce misc mc7 Exception returned: %s" % str(e))

def parse_mce_misc_mc4_addr(data, name):
    """
    bit 23: 16 - CORRECTED_ERROR_COUNT
    bit 15: 0 - ERROR_ADDRESS
    """
    output = ""
    try:
        ret_value = hex_to_bin_bit(data, name)
        ret = int(ret_value[16:26][::-1], 2)
        if ret:
            output = "CORRECTED_ERROR_COUNT(23:16) : " + str(ret) + " : "
        if int(ret_value[0:16][::-1], 2):
            output = output + "ERROR_ADDRESS(15:0) : " + ret_value[0:16][::-1] + " : "
        return output
    except Exception as e:
        print("Parse mce misc mc4 Exception returned: %s" % str(e))

def parse_mce_misc_mc3_addr(data, name):
    """
    bit 23 - THREAD
    bit 22:20 - WAY
    bit 19: 16 - SQID
    bit 8:6 - ADDRMODE
    bit 5:0 - RECADDRLSB
    """
    output = ""
    try:
        ret_value = hex_to_bin_bit(data, name)
        if int(ret_value[23], 2):
            output = "THREAD(23) : "
        if int(ret_value[20:23][::-1], 2):
            output = output + "WAY(22:20) : " + ret_value[20:23][::-1] + " : "
        if int(ret_value[16:20][::-1], 2):
            output = output + "SQID(19:16) : " + ret_value[16:20][::-1] + " : "
        output = output + parse_mce_misc_mc0_addr(data, name)
        return output
    except Exception as e:
        print("Parse mce misc mc3 Exception returned: %s" % str(e))

