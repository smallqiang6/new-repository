#Step-2 : parse lsb bite 0-31
#Step-3 : name = ADDRV bit 58
#Step-4 : name = MISCV bit 59
def parse_bank_log(data, ret_out, addr_name, misc_name, name):
    output = ""
    ret = 0
    try:
        ret_value = hex_to_bin_bit(ret_out, name)
        if int(ret_value[63], 2) == 0:
            ret = 1
            return ret, output
        output = output + parse_mce_bank_lsb(ret_value, name)
        if int(ret_value[58], 2):
            if (addr_name in data) and len(data[addr_name].split(" ")) > 0:
                ret_out = data[addr_name].split(" ")
                output = output + addr_name + " : "  + joint_addr(ret_out) + " : "
            else:
                output = output + "%s does not exist, or no data" % addr_name

        if int(ret_value[59], 2):
            if (misc_name in data) and (len(data[misc_name].split(" ")) > 0):
                ret_out = data[misc_name].split(" ")
                output = output + misc_name + " : " + joint_addr(ret_out) + " : " + parse_mce_misc_addr(ret_out, misc_name)
            else:
                output = output + "%s does not exist, or no data" % misc_name
        return ret, output
    except Exception as e:
        print("Parse bank log Exception returned: %s" % str(e))

