+/**
+ * march_g
+ * @iter: 重复次数
+ * @p1: 写入的数据pattern1
+ * @p2: 写入的数据pattern2
+ *
+ * 低地址到高地址，对同个地址:读p1、写p2、再读p2、写p1
+ * 低地址到高地址，对同个地址:读p2、先写p1再写p2
+ * 高地址到低地址，对同个地址:读p2、先写p1、写p2、再写p1
+ * 高地址到低地址，对同个地址:读p1、先写p2、再写p1
+ *
+ * 无返回值
+ */
+static int march_g(char *desc, int iter, uint32 p1, uint32 p2)
+{
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ALL, "Iter:%d P1:0x%x p2:0x%x.\n", iter, p1, p2);
+    /* 低地址到高地址，写p1  */
+    fd_write_value_low_to_high(p1);
+
+    /* 低地址到高地址，对同个地址:读p1、写p2、再读p2、写p1 */
+    if (fd_write_value_low_to_high_check_two(p1, p2, 1, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    /* 低地址到高地址，对同个地址:读p2、先写p1再写p2 */
+    if (fd_write_value_low_to_high_check(p2, p1, 2, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    /* 高地址到低地址，对同个地址:读p2、先写p1、写p2、再写p1 */
+    if (fd_write_value_high_to_low_check(p2, p1, 3, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    /* 高地址到低地址，对同个地址:读p1、先写p2、再写p1 */
+    if (fd_write_value_high_to_low_check(p1, p2, 2, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    /* 高地址到低地址，对同个地址:读p1 */
+    if (fd_write_value_low_to_high_check(p1, p2, 0, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    return GRTD_SUCCESS;
+}
