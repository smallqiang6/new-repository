+/**
+ * march_c
+ * @iter: 重复次数
+ * @p1: 写入的数据pattern1
+ * @p2: 写入的数据pattern2
+ *
+ * 低地址到高地址，读p1，写p2，再读p2，写p1
+ * 高地址到低地址，读p1，写p2，再读p2，写p1
+ *
+ * 无返回值
+ */
+static int march_c(char *desc, int iter, volatile uint32 p1, volatile uint32 p2)
+{
+    int i;
+    uint32   p_temp;
+
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ALL, "Iter:%d P1:0x%x p2:0x%x.\n", iter, p1, p2);
+    /* 低地址到高地址，写p1  */
+    fd_write_value_low_to_high(p1);
+
+    /* 低地址到高地址，读p1，写p2，再读p2，写p1 */
+    for (i = 0; i < 2; i++) {
+        if (fd_write_value_low_to_high_check(p1, p2, 1, desc)) {
+            return FT_DDR_ERR;
+        }
+        /* p1、p2值互换 */
+        p_temp = p1;
+        p1 = p2;
+        p2 = p_temp;
+    }
+
+    /* 高地址到低地址，读p1，写p2，再读p2，写p1 */
+    for (i = 0; i < 2; i++) {
+        if (fd_write_value_high_to_low_check(p1, p2, 1, desc)) {
+            return FT_DDR_ERR;
+        }
+        /* p1、p2值互换 */
+        p_temp = p1;
+        p1 = p2;
+        p2 = p_temp;
+    }
+
+    /* 验证最后写入的p1值 */
+    if (fd_write_value_low_to_high_check(p1, p2, 0, desc)) {
+        return FT_DDR_ERR;
+    }
+
+    return GRTD_SUCCESS;
+}
