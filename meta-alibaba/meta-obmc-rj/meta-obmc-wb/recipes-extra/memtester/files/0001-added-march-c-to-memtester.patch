+/**
+ * column_operate
+ * @iter: 重复次数
+ * @p1: 写入的数据pattern1
+ * @col_num: 列地址偏移
+ *
+ * 采用"列操作"算法
+ * 低地址到高地址，对(n * step + col_addr)地址写p1
+ *
+ * 无返回值
+ */
+static int column_operate(char *desc, int iter, uint32 p1, uint32 col_num)
+{
+    int     j, k, done;
+    uvpv pe;
+    uvpv start, end;
+    ul   n;
+    ul   step = 0x2000;
+    ul   addr;
+    ul   col_addr;
+
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    /* 低地址到高地址，对(n * step + col_addr)地址写p1  */
+    for (k = 0; k < iter; k++) {
+
+        for (j = 0; j < segs; j++) {
+            start = v->map[j].start;
+            end = v->map[j].end;
+            pe = start;
+            pp = start;
+            done = 0;
+
+            if (((ul) start % step) <= (col_num & 0x3FF) << 3) {
+                n = (ul) start / step;
+            } else {
+                n = (ul) start / step + 1;
+            }
+            do {
+                /* Check for overflow */
+                if (fd_check_overflow(&pe, end, &done)) {
+                    break;
+                }
+
+                do {
+                    col_addr = (col_num & 0x3FF) << 3;
+                    addr = n * step + col_addr;
+                    pp = (uint32 *) addr;
+                    if (pp >= end)
+                        break;
+                    *pp = p1;
+                    n++;
+                } while (pp < pe);
+            } while (!done);
+        }
+
+        /* 低地址到高地址，验证(n * step + col_addr)地址值  */
+        for (j = 0; j < segs; j++) {
+            start = v->map[j].start;
+            end = v->map[j].end;
+            pe = start;
+            pp = start;
+            done = 0;
+            if (((ul) start % step) < (col_num & 0x3FF) << 3) {
+                n = (ul) start / step;
+            } else {
+                n = (ul) start / step + 1;
+            }
+            do {
+                /* Check for overflow */
+                if (fd_check_overflow(&pe, end, &done)) {
+                    break;
+                }
+
+                do {
+                    col_addr = (col_num & 0x3FF) << 3;
+                    addr = n * step + col_addr;
+                    pp = (uint32 *) addr;
+                    if (pp >= end)
+                        break;
+                    if (*pp != p1) {
+                        //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, p1, *pp);
+                        sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, p1, *pp);
+                        fail = 1;
+                        return FT_DDR_ERR;
+                    }
+                    n++;
+                } while (pp < pe);
+            } while (!done);
+        }
+
+    }
+
+    return GRTD_SUCCESS;
+}
