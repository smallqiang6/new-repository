+    {0, ddr_mov_inv_0_1, "Moving inversion - 0&1 test"},                      /* 移动反转-0&1测试，不拷机 */
+    {1, ddr_mov_inv_8_pat, "Moving inversion - 8bit test"},                   /* 移动反转-8bit测试 */
+    {0, ddr_mov_inv_32_pat, "Moving inversion - 32bit test"},                 /* 移动反转-32bit测试，不拷机 */
+    {0, ddr_mod20_random_pat, "Modulo 20 - random number test"},                  /* 模20-随机数测试，不拷机  */
