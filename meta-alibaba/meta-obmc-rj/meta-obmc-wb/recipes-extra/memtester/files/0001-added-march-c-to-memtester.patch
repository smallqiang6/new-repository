+static unsigned int SEED_X = 521288629;
+static unsigned int SEED_Y = 362436069;
+
+/* dma传输时的内存块大小 */
+int blk_size_array[BLK_SIZE_NUM_MAX] = {
+    0x2000000, /* 32MB */
