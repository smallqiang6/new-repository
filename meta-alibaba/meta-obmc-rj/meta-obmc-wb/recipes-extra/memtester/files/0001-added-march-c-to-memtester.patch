+
+static inline ul roundup(ul value, ul mask)
+{
+    return (value + mask) & ~mask;
+}
+
+void rand_seed(unsigned int seed1, unsigned int seed2)
+{
+    if (seed1)
+        SEED_X = seed1;         /* use default seeds if parameter is 0 */
+    if (seed2)
+        SEED_Y = seed2;
+}
+
+static inline unsigned int ft_rand()
+{
+    static unsigned int a = 18000, b = 30903;
+
+    SEED_X = a * (SEED_X & 65535) + (SEED_X >> 16);
+    SEED_Y = b * (SEED_Y & 65535) + (SEED_Y >> 16);
+
+    return ((SEED_X << 16) + (SEED_Y & 65535));
+}
+
+static int fd_check_overflow(uvpv *pe, uint32 volatile * volatile end, int *done)
+{
+    /* Check for overflow */
+    if (*pe + SPINSZ > *pe) {
+        *pe += SPINSZ;
+    } else {
+        *pe = end;
+    }
+    if (*pe >= end) {
+        *pe = end;
+        (*done)++;
+    }
+    if (pp >= *pe) {
+        return 1;
+    }
+
+    return 0;
+}
+
+static int fd_check_underflow(uvpv *pe, uvpv start, int *done)
+{
+    /* Check for underflow */
+    if (*pe - SPINSZ < *pe) {
+        *pe -= SPINSZ;
+    } else {
+        *pe = start;
+    }
+    if (*pe <= start) {
+        *pe = start;
+        (*done)++;
+    }
+    if (pp == *pe) {
+        return 1;
+    }
+
+    return 0;
+}
+
+/**
+ * addrress_walking
+ *
+ * 使用"地址测试"算法
+ * 要写入数据的地址变换规则如下:
+ * address = 初始地址 | (mask << 1)
+ *
+ * 无返回值
+ */
+static int addrress_walking(char *desc)
+{
+    int     i, j, k;
+    uvpv pt, end;
+    uint32 mask, bank;
+
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    /* Test the global address bits */
+    for (p1 = 0, j = 0; j < 2; j++) {
+        /* 设置初始地址0x20000对齐 */
+        pp = (uint32 *)roundup((ul)v->map[0].start, 0x1ffff);
+        *pp = p1;
+
+        /* Now write pattern compliment */
+        p1 = ~p1;
+        end = v->map[segs - 1].end;
+        for (i = 0; i < 1000; i++) {
+            mask = 4;
+            do {
+                pt = (uint32 *) ((ul) pp | mask);
+                if (pt == pp) {
+                    mask = mask << 1;
+                    continue;
+                }
+                if (pt >= end) {
+                    break;
+                }
+                *pt = p1;
+                if (*pp != ~p1) {
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, ~p1, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                mask = mask << 1;
+            } while (mask);
+        }
+        //FT_DDR_SHOW();
+    }
+
+    /* Now check the address bits in each bank
+     * If we have more than 8mb of memory then the bank size must be
+     * bigger than 256k.  If so use 1mb for the bank size.
+     */
+    if (v->pmap[v->msegs - 1].end > (0x800000 >> 12)) {
+        bank = 0x100000;
+    } else {
+        bank = 0x40000;
+    }
+
+    for (p1 = 0, k = 0; k < 2; k++) {
+        for (j = 0; j < segs; j++) {
+            pp = v->map[j].start;
+            /* 设置初始地址256k对齐 */
+            pp = (uint32 *) roundup((ul) pp, bank - 1);
+            end = v->map[j].end;
+            while (pp < end) {
+                *pp = p1;
+                p1 = ~p1;
+                for (i = 0; i < 200; i++) {
+                    mask = 4;
+                    do {
+                        pt = (uint32 *)((ul) pp | mask);
+                        if (pt == pp) {
+                            mask = mask << 1;
+                            continue;
+                        }
+                        if (pt >= end) {
+                            break;
+                        }
+                        *pt = p1;
+                        if (*pp != ~p1) {
+                            sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, ~p1, *pp);
+                            fail = 1;
+                            return FT_DDR_ERR;
+                        }
+                        mask = mask << 1;
+                    } while (mask);
+                }
+                if (pp + bank > pp) {
+                    pp += bank;
+                } else {
+                    pp = end;
+                }
+                p1 = ~p1;
+            }
+        }
+        p1 = ~p1;
+        //FT_DDR_SHOW();
+    }
+
+    return GRTD_SUCCESS;
+}
+
+static void fd_write_value_low_to_high(uint32 write)
+{
+    int     j, done;
+    uint32 volatile * volatile pe;
+    uint32 volatile * volatile start;
+    uint32 volatile * volatile end;
+
+    for (j = 0; j < segs; j++) {
+        start = v->map[j].start;
+        end = v->map[j].end;
+        pe = start;
+        pp = start;
+        done = 0;
+        do {
+            /* Check for overflow */
+            if (fd_check_overflow(&pe, end, &done)) {
+                break;
+            }
+
+            for (; pp < pe; pp++) {
+                *pp = write;
+            }
+        } while (!done);
+        //FT_DDR_SHOW();
+    }
+}
+
+static int fd_write_value_low_to_high_check(uint32 check, uint32 write, int is_write, char * desc)
+{
+    int     j, done;
+    uint32 volatile * volatile pe;
+    uint32 volatile * volatile start;
+    uint32 volatile * volatile end;
+    /* 验证写入数据，从低地址到高地址，往测试内存区域写入p2值 */
+    for (j = 0; j < segs; j++) {
+        start = v->map[j].start;
+        end = v->map[j].end;
+        pe = start;
+        pp = start;
+        done = 0;
+        do {
+            /* Check for overflow */
+            if (fd_check_overflow(&pe, end, &done)) {
+                break;
+            }
+
+            for (; pp < pe; pp++) {
+
+                if (*pp != check) {
+                    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                if (is_write == 1) {
+                    *pp = write;
+                } else if (is_write == 2) {
+                    *pp = write;
+                    *pp = check;
+                }
+            }
+        } while (!done);
+        //FT_DDR_SHOW();
+    }
+
+    return FT_DDR_SUCCESS;
+}
+
+static int fd_write_value_low_to_high_check_two(uint32 check, uint32 write, int is_write, char * desc)
+{
+    int     j, done;
+    uint32 volatile * volatile pe;
+    uint32 volatile * volatile start;
+    uint32 volatile * volatile end;
+
+    for (j = 0; j < segs; j++) {
+        start = v->map[j].start;
+        end = v->map[j].end;
+        pe = start;
+        pp = start;
+        done = 0;
+        do {
+            /* Check for overflow */
+            if (fd_check_overflow(&pe, end, &done)) {
+                break;
+            }
+            for (; pp < pe; pp++) {
+                if (*pp != check) {
+                    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                *pp = write;
+                if (*pp != write) {
+                    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, write, *pp);
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, write, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                *pp = check;
+                if (*pp != check) {
+                    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                *pp = write;
+            }
+        } while (!done);
+        //FT_DDR_SHOW();
+    }
+
+    return FT_DDR_SUCCESS;
+}
+
+static int fd_write_value_high_to_low_check(uint32 check, uint32 write, int is_write, char * desc)
+{
+    int     j, done;
+    uvpv pe,start,end;
+
+    /* 验证写入数据，从高地址到低地址，往测试内存区域写入p1值 */
+    for (j = segs - 1; j >= 0; j--) {
+        start = v->map[j].start;
+        end = v->map[j].end;
+        pe = end - 1;
+        pp = end - 1;
+        done = 0;
+        do {
+            /* Check for underflow */
+            if (fd_check_underflow(&pe, start, &done)) {
+                break;
+            }
+
+            do {
+                if (*pp != check) {
+                    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, check, *pp);
+                    fail = 1;
+                    return FT_DDR_ERR;
+                }
+                if (is_write == 1) {
+                    *pp = write;
+                } else if (is_write == 2) {
+                    *pp = write;
+                    *pp = check;
+                } else if (is_write == 3) {
+                    *pp = write;
+                    *pp = check;
+                    *pp = write;
+                }
+            } while (pp-- > pe);
+        } while (!done);
+        //FT_DDR_SHOW();
+    }
+
+    return FT_DDR_SUCCESS;
+}
+
+/**
+ * moving_inversions
+ * @iter: 重复次数
+ * @p1: 写入的数据pattern1
+ * @p2: 写入的数据pattern2
+ *
+ * 使用"移动反转"算法，写内存地址从低地址到高地址及从高地址到地址；
+ * 先往测试内存区域写入p1数据格式，并检验写入数据是否正确；
+ * 再往测试内存区域写入~p1数据格式，并检验写入数据是否正确；
+ *
+ * 成功返回0；失败返回1
+ */
+static int moving_inversions(char * desc, int iter, uint32 p1, uint32 p2)
+{
+    int i;
+
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ALL, "Iter:%d P1:0x%x P2:0x%x.\n", iter, p1, p2);
+    /* 从低地址到高地址，往测试内存区域写入p1值  */
+    fd_write_value_low_to_high(p1);
+
+    for (i = 0; i < iter; i++) {
+         /* 验证写入数据，从低地址到高地址，往测试内存区域写入p2值 */
+        if (fd_write_value_low_to_high_check(p1, p2, 1, desc)) {
+            return FT_DDR_ERR;
+        }
+
+        /* 验证写入数据，从高地址到低地址，往测试内存区域写入p1值 */
+        if (fd_write_value_high_to_low_check(p2, p1, 1, desc)) {
+            return FT_DDR_ERR;
+        }
+    }
+
+    return GRTD_SUCCESS;
+}
+
+/**
+ * moving_inversions32
+ * @iter: 重复次数
+ * @p1: 第一次写内存时的数据pattern
+ * @low_pattern: 低地址到高地址写内存时的初始数据pattern
+ * @high_pattern: 高地址到低地址写内存时的初始数据pattern
+ * @sval: 每次修改写入数据pattern需要或上的值
+ * @offset: 第一次写内存时的比特偏移，low_pattern = p1 >> offset
+ *
+ * 采用"移动反转-32bit"算法，该算法以32次写操作为一循环，每次写操
+ * 作之后，对于低地址到高地址写内存，写入的数据pattern需要左移1比特；
+ * 对于高地址到低地址写内存，写入的数据pattern需要右移1比特。
+ *
+ * 成功返回0；失败返回1
+ */
+static int moving_inversions32(char *desc, int iter, uint32 p1, uint32 low_pattern, uint32 high_pattern, int sval, int offset)
+{
+    int     i, j, k = 0, done;
+    uint32 volatile * volatile pe;
+    uint32 volatile * volatile start;
+    uint32 volatile * volatile end;
+    uint32   pattern = 0;
+    uint32   p3 = sval << 31;
+
+    if (fail) {
+        sprintf(desc, "No test.");
+        return FT_DDR_ERR;
+    }
+
+    //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ALL, "Iter:%d P1:0x%x low_pattern:0x%x high_pattern:0x%x sval:%d offset:%d.\n",
+    //                iter, p1, low_pattern, high_pattern, sval, offset);
+    /* 从低地址到高地址，往测试内存区域写入pattern值  */
+    for (j = 0; j < segs; j++) {
+        start = v->map[j].start;
+        end = v->map[j].end;
+        pe = start;
+        pp = start;
+        done = 0;
+        k = offset;
+        pattern = p1;
+        do {
+            /* Check for overflow */
+            if (fd_check_overflow(&pe, end, &done)) {
+                break;
+            }
+            while (pp < pe) {
+                *pp = pattern;
+                if (++k >= 32) {
+                    pattern = low_pattern;
+                    k = 0;
+                } else {
+                    pattern = pattern << 1;
+                    pattern |= sval;
+                }
+                pp++;
+            }
+        } while (!done);
+        //FT_DDR_SHOW();
+    }
+
+    for (i = 0; i < iter; i++) {
+        /* 验证写入数据，从低地址到高地址，往测试内存区域写入pattern值 */
+        for (j = 0; j < segs; j++) {
+            start = v->map[j].start;
+            end = v->map[j].end;
+            pe = start;
+            pp = start;
+            done = 0;
+            k = offset;
+            pattern = p1;
+            do {
+                /* Check for overflow */
+                if (fd_check_overflow(&pe, end, &done)) {
+                    break;
+                }
+
+                while (pp < pe) {
+                    if (*pp != pattern) {
+                        //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, pattern, *pp);
+                        sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, pattern, *pp);
+                        fail = 1;
+                        return FT_DDR_ERR;
+                    }
+                    *pp = ~pattern;
+                    if (++k >= 32) {
+                        pattern = low_pattern;
+                        k = 0;
+                    } else {
+                        pattern = pattern << 1;
+                        pattern |= sval;
+                    }
+                    pp++;
+                }
+            } while (!done);
+            //FT_DDR_SHOW();
+        }
+
+        /* 验证写入数据，从高地址到低地址，往测试内存区域写入pattern值 */
+        pattern = low_pattern;
+        if (0 != (k = (k - 1) & 31)) {
+            pattern = (pattern << k);
+            if (sval)
+                pattern |= ((sval << k) - 1);
+        }
+        k++;
+        for (j = segs - 1; j >= 0; j--) {
+            start = v->map[j].start;
+            end = v->map[j].end;
+            pp = end - 1;
+            pe = end - 1;
+            done = 0;
+            do {
+                /* Check for underflow */
+                if (fd_check_underflow(&pe, start, &done)) {
+                    break;
+                }
+
+                do {
+                    if (*pp != ~pattern) {
+                        //GRTD_TEST_DBG(GRTD_DBG_LEVEL_ERROR, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, ~pattern, *pp);
+                        sprintf(desc, "[0x%08lx] should be 0x%x,but is 0x%x.\n", (ul) pp, ~pattern, *pp);
+                        fail = 1;
+                        return FT_DDR_ERR;
+                    }
+                    *pp = pattern;
+                    if (--k <= 0) {
+                        pattern = high_pattern;
+                        k = 32;
+                    } else {
+                        pattern = pattern >> 1;
+                        pattern |= p3;
+                    }
+                } while (pp-- > pe);
+            } while (!done);
+            //FT_DDR_SHOW();
+        }
+    }
+
+    return GRTD_SUCCESS;
+}
