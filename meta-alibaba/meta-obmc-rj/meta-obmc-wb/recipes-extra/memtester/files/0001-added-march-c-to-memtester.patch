+	char desc[4095];
+    char *env_testmask = 0;
+    ul algorithm = 0;
+
+	/* If MEMTESTER_TEST_MASK is set, we use its value as a mask of which
+		tests we run.
+	  */
+	 if (env_testmask = getenv("MEMTESTER_TEST_RJ_MASK")) {
+		 //errno = 0;
+		 algorithm = strtoul(env_testmask, 0, 0);
+		 if (errno) {
+			 fprintf(stderr, "error parsing MEMTESTER_TEST_RJ_MASK %s: %s\n", 
+					 env_testmask, strerror(errno));
+		 }
+		 printf("\n\tusing rj testmask 0x%lx\n", algorithm);
+	 }
+
+
+	return platform_complex_sys_memory_test(desc, kaoji, bufa,totalsz, algorithm);
+}
