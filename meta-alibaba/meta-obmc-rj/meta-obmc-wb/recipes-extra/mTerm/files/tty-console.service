[Unit]
Description=The mTerm daemon to monitor CPU console
PartOf=init-early.service
After=init-early.service

[Service]
EnvironmentFile=/etc/device/baudrate.conf
ExecStart=/usr/local/bin/mTerm_server ttyS0 /dev/ttyS0 $ttyS0_baudrate

[Install]
WantedBy=bmc.target
