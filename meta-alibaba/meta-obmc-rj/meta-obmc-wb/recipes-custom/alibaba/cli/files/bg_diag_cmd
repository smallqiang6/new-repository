def exec_task(taskliststr):
    r'''remove_one_flash'''
    cmd = RjRawCmd()
    halfw = HalFirmware()
    tasklist = taskliststr.split(",")
    error_total = 0
    for taskstr in tasklist:
        ret = -1
        output = ""
        print("%s taskstr" %taskstr)
        start_time = datetime.datetime.now()
        if (taskstr == "get_fpga_md5sum"):
            ret, output = cmd.param_manage("rj_rawcmd_cli get fpga_md5sum")
            print("%s: %s"%(taskstr, output))
        elif (taskstr == "get_mac_md5sum"):
            ret, output = cmd.param_manage("rj_rawcmd_cli get mac_md5sum")
            print("%s: %s"%(taskstr, output))
        elif (taskstr == "upd_bmc_master"):
            ret = halfw.program_bmc("master", "/var/log/upgrade/bmc_bin")
        elif (taskstr == "upd_bmc_slave"):
            ret = upgrade_bmc_slave()
        elif (taskstr == "upd_bios_master"):
            ret = halfw.program_bios("master", "/var/log/upgrade/bios_bin")
        elif  (taskstr == "upd_bios_slave"):
            ret = halfw.program_bios("slave", "/var/log/upgrade/bios_bin")
        elif (taskstr == "upd_fpga"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_fpga /var/log/upgrade/fpga_bin")
        elif (taskstr == "upd_5387"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_5387 /var/log/upgrade/5387_bin")  
        elif (taskstr == "upd_88e6321"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_88e6321 /var/log/upgrade/88e6321_bin")
        elif (taskstr == "upd_8367"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_8367 /var/log/upgrade/8367_bin")
        elif (taskstr == "upd_bcm53134"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_bcm53134 /var/log/upgrade/bcm53134_bin")
        elif (taskstr == "upd_mac"):
            ret, output = cmd.param_manage("rj_rawcmd_cli upgrade_mac /var/log/upgrade/mac_bin")
        elif (taskstr == "upd_cpld"):
            ret = upgrade_cpld()
        else:
            pass
        end_time = datetime.datetime.now()
        if ret != -1:
            result = "SUCCESS"
        else:
            result = "FAILED"
            error_total -= 1
        print("%s: %s, %s to %s\n"%(taskstr, result, start_time, end_time))
    if error_total >= 0:
        print("TEST_SUCCESS\n")
    else:
        print("TEST_FAILED\n")

