+static int get_dev_info_from_fru_eeprom(u_int8_t *eeprom, dev_info_t **dev_info)
+{
+    int i, ret, offset;
+    u_int8_t mac_addr[MAC_ADDR_LENGTH];
+    char product[PRODUCT_INFO_LEN];
+    int mac_addr_valid_flag;
+    u8 crc;
+    u32 len;
+
+    crc = calculate_crc(eeprom, IPMI_FRU_COMMON_HEADER - 1);
+    if (crc != eeprom[IPMI_FRU_COMMON_HEADER - 1]) {
+        printf("Invalid fru header crc: 0x%02x(must 0x%02x).\n", eeprom[IPMI_FRU_COMMON_HEADER - 1], crc);
+        return -1;
+    }
+
+    offset = eeprom[IPMI_FRU_PRODUCT_OFFSET] * 8;
+    if (offset > PRODUCT_EEPROM_LEN) {
+        printf("Error product area offset: %d.\n", offset);
+        return -1;
+    }
+
+    memset(product, 0, sizeof(product));
+    /* skip Product Area Format Version, Product Area Length and Language Code */
+    offset += 3;
+    for (i = 0; i < IPMI_FRU_PRODUCT_NAME_INDEX; i++) {
+        len = (eeprom[offset] & (~IPMI_FRU_TYPE_LENGTH_TYPE_CODE_MASK)) & 0xff;
+        if ((i+1) == IPMI_FRU_PRODUCT_NAME_INDEX) {
+            if (len >= PRODUCT_INFO_LEN) {
+                printf("Error: prodcut name length: %d\n", len);
+                len = PRODUCT_INFO_LEN - 1;
+            }
+            memcpy(product, &(eeprom[offset + 1]), len);
+            break;
+        }
+        offset += 1;
+        offset += len;
+    }
+
+    if (i == IPMI_FRU_PRODUCT_NAME_INDEX) {
+        printf("No found product name from fru eeprom.\n");
+        return -1;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(g_dev_info_list); i++) {
+        if (strcmp(product, g_dev_info_list[i].dev_name) == 0) {
+            /* name match */
+            *dev_info = &g_dev_info_list[i];
+            break;
+        }
+    }
+
+    if (i == ARRAY_SIZE(g_dev_info_list)) {
+        printf("Product name: %s not found in dev_info_list.\n", product);
+        return -1;
+    }
+
+    /* get MAC addr */
+    memset(mac_addr, 0, sizeof(mac_addr));
+    ret = get_mac_from_fru_eeprom(eeprom, mac_addr, sizeof(mac_addr), (*dev_info)->fru_mac_extra_index);
+    if (ret < 0) {
+        ast_debug("Failed to read mac address\n");
+        mac_addr_valid_flag = 0;
+    } else {
+        calc_bmc_mac(mac_addr);
+        if (is_valid_ethaddr(mac_addr)) {
+            mac_addr_valid_flag = 1;
+        } else {
+            mac_addr_valid_flag = 0;
+        }
+    }
+
+    (*dev_info)->mac_addr_valid_flag = mac_addr_valid_flag;
+    if (mac_addr_valid_flag) {
+        memcpy((*dev_info)->mac_addr , mac_addr, MAC_ADDR_LENGTH);
+    }
+
+    return 0;
+}
