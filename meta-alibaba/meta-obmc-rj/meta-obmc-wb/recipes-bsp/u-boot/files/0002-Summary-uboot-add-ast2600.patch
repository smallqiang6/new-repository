+static void calc_bmc_mac(u_int8_t *mac_addr)
+{
+    int i, tmp_val;
+
+    tmp_val = mac_addr[MAC_ADDR_LENGTH - 1] + 2;
+    if (tmp_val > 0xff) {
+        mac_addr[MAC_ADDR_LENGTH - 1] = tmp_val & 0xff;
+        for (i = 1; i < MAC_ADDR_LENGTH; i++) {
+            if (mac_addr[MAC_ADDR_LENGTH - i - 1] == 0xff) {
+                mac_addr[MAC_ADDR_LENGTH - i - 1] = 0;
+            } else {
+                mac_addr[MAC_ADDR_LENGTH - i - 1]++;
+                break;
+            }
+        }
+    } else {
+        mac_addr[MAC_ADDR_LENGTH - 1] = tmp_val & 0xff;
+    }
+    return;
+}
