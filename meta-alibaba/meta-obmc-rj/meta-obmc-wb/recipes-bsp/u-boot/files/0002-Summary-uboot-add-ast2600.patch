+}
+
+static int get_dev_info_from_wedge_eeprom(u_int8_t *eeprom, dev_info_t **dev_info)
+{
+    int i, ret;
+    u_int8_t mac_addr[MAC_ADDR_LENGTH];
+    char product[PRODUCT_INFO_LEN];
+    int mac_addr_valid_flag;
+
+    /* get MAC addr */
+    memset(mac_addr, 0, sizeof(mac_addr));
+    ret = get_mac_from_wedge_eeprom(eeprom, mac_addr, sizeof(mac_addr));
+    if (ret < 0) {
+        ast_debug("Failed to read mac address\n");
+        mac_addr_valid_flag = 0;
+    } else {
+        calc_bmc_mac(mac_addr);
+        if (is_valid_ethaddr(mac_addr)) {
+            mac_addr_valid_flag = 1;
+        } else {
+            mac_addr_valid_flag = 0;
+        }
+    }
+
+
+    memset(product, 0, sizeof(product));
+    ret = get_product_name_from_wedge_eeprom(eeprom, product, sizeof(product) - 1);
+    if (ret < 0) {
+        return ret;
+    }
+
+    for (i = 0; i < (sizeof(g_dev_info_list) / sizeof(dev_info_t)); i++) {
+        if (strcmp(product, g_dev_info_list[i].dev_name) == 0) {
+            /* name match */
+            *dev_info = &g_dev_info_list[i];
+            (*dev_info)->mac_addr_valid_flag = mac_addr_valid_flag;
+            if (mac_addr_valid_flag) {
+                memcpy((*dev_info)->mac_addr , mac_addr, MAC_ADDR_LENGTH);
+            }
+            return 0;
+        }
+    }
+    return -1;
+}
+
+static int pca9641_set_bus(struct udevice *dev)
+{
+    int ret;
+    u8 reg_ctl, reg_sts;
+
+    ret = dm_i2c_read(dev, PCA9641_CONTROL, &reg_ctl, 1);
+    if (ret < 0) {
+        ast_debug("Failed to read pca9641.\n");
+        return -1;
+    }
+
+    ret = dm_i2c_read(dev, PCA9641_STATUS, &reg_sts, 1);
+    if (ret < 0) {
+        ast_debug("Failed to read pca9641.\n");
+        return -1;
+    }
+
+    reg_ctl |= PCA9641_CTL_PRIORITY; /* set pca9641 priority */
+    if (BUSOFF(reg_ctl, reg_sts)) {
+        reg_ctl |= PCA9641_CTL_LOCK_REQ;
+        ret = dm_i2c_write(dev, PCA9641_CONTROL, &reg_ctl, 1);
+        if (ret < 0) {
+            ast_debug("Failed to write pca9641: 0x%02x.(busoff)\n", PCA9641_CONTROL);
+            return -1;
+        }
+
+        ret = dm_i2c_read(dev, PCA9641_CONTROL, &reg_ctl, 1);
+        if (ret < 0) {
+            ast_debug("Failed to read pca9641: 0x%02x.(busoff)\n", PCA9641_CONTROL);
+            return -1;
+        }
+
+        if (lock_grant(reg_ctl)) {
+            reg_ctl |= PCA9641_CTL_BUS_CONNECT | PCA9641_CTL_LOCK_REQ;
+            ret = dm_i2c_write(dev, PCA9641_CONTROL, &reg_ctl, 1);
+            if (ret < 0) {
+                ast_debug("Failed to write pca9641: 0x%02x.(busoff, lock_grant)\n", PCA9641_CONTROL);
+                return -1;
+            }
+        } else {
+            return -1;
+        }
+    } else if (lock_grant(reg_ctl)) {
+        reg_ctl |= PCA9641_CTL_BUS_CONNECT | PCA9641_CTL_LOCK_REQ;
+        ret = dm_i2c_write(dev, PCA9641_CONTROL, &reg_ctl, 1);
+        if (ret < 0) {
+            ast_debug("Failed to write pca9641: 0x%02x.(lock_grant)\n", PCA9641_CONTROL);
+            return -1;
+        }
+    } else if (other_lock(reg_sts)) {
+        reg_ctl |= PCA9641_CTL_LOCK_REQ;
+        ret = dm_i2c_write(dev, PCA9641_CONTROL, &reg_ctl, 1);
+        if (ret < 0) {
+            ast_debug("Failed to write pca9641: 0x%02x.(other_lock)\n", PCA9641_CONTROL);
+            return -1;
+        }
+        return -1;
+    }
+
+    return 0;
+}
+
+static int pca9641_detect(struct udevice *dev)
+{
+    int ret;
+    u8 reg_ctl;
+
+    ret = dm_i2c_read(dev, PCA9641_CONTROL, &reg_ctl, 1);
+    if (ret < 0) {
+        ast_debug("Failed to read pca9641.\n");
+        return -1;
+    }
+
+    return 0;
+}
+
+static void pca9641_release_bus(struct udevice *dev)
+{
+    int ret;
+    u8 reg_ctl;
+
+    reg_ctl = 0;
+    ret = dm_i2c_write(dev, PCA9641_CONTROL, &reg_ctl, 1);
+    if (ret < 0) {
+        ast_debug("Failed to release pca9641: 0x%02x.\n", PCA9641_CONTROL);
+    }
+
+}
