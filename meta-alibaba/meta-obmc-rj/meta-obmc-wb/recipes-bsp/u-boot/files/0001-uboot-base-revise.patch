+static void vboot_finish(void)
+{
+  /* Clean the handoff marker from ROM. */
+  volatile struct vbs *vbs = (volatile struct vbs*)AST_SRAM_VBS_BASE;
+  vbs->rom_handoff = 0x0;
+
+#ifdef CONFIG_ASPEED_TPM
