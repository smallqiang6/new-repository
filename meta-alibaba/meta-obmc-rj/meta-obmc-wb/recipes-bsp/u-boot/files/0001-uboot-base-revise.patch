+static int decode_tlv_value(tlvinfo_tlv_t *tlv, tlv_decode_value_t *decode_value)
+{
+    char *value;
+    u_int32_t length;
+
+    value = (char *)decode_value->value;
+
+    switch (tlv->type) {
+    case TLV_CODE_PRODUCT_NAME:
+    case TLV_CODE_MAC_BASE:
+        if (tlv->length >= PRODUCT_INFO_LEN) {
+            length = PRODUCT_INFO_LEN - 1;
+        } else {
+            length = tlv->length;
+        }
+        memcpy(value, tlv->value, length);
+        value[length] = 0;
+        break;
+    default:
+        printf("Error tlv type: %d.\n", tlv->type);
+        return -1;
+    }
+
+    decode_value->length = length;
+    return 0;
+}
+
+static void ext_cmd_decode_tlv_value(tlvinfo_tlv_t *tlv, tlv_decode_value_t *decode_value)
+{
+    char *value;
+    u_int32_t length;
+
+    length = 0;
+    value = (char *)decode_value->value;
+
+    switch (tlv->type) {
+    case TLV_CODE_EXT_CARD_ID:
+        if (tlv->length >= PRODUCT_INFO_LEN) {
+            length = PRODUCT_INFO_LEN - 1;
+        } else {
+            length = tlv->length;
+        }
+        memcpy(value, tlv->value, length);
+        value[length] = 0;
+    	break;
+    default:
+        printf("Error tlv type: %d.\n", tlv->type);
+        break;
+    }
+
+    decode_value->length = length;
+}
