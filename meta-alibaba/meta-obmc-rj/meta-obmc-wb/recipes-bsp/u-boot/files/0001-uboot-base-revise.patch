+static void set_svr_pwr_btn(int level)
+{
+  u32 reg;
+  // GPIOE3
+  // output
+  reg = __raw_readl(AST_GPIO_BASE + 0x24);
+  __raw_writel(reg | (1 << 3), AST_GPIO_BASE + 0x24);
+
+  reg = __raw_readl(AST_GPIO_BASE + 0x20);
+  if (level) //high
+    reg |= (1<<3);
+  else // low
+    reg &= ~(1<<3);
+  __raw_writel(reg, AST_GPIO_BASE + 0x20);
+}
