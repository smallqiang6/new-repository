+static inline int _a2v(const uint8_t *a)
+{
+  uint8_t v = *a;
+
+  if ('0' <= v && v <= '9') {
+    return v - '0';
+  }
+  if ('a' <= v && v <= 'f') {
+    return v - 'a' + 10;
+  }
+  if ('A' <= v && v <= 'F') {
+    return v - 'A' + 10;
+  }
+  return -1;
+}
+
+
+static inline int is_valid_tlv(tlvinfo_tlv_t *tlv)
+{
+    return ((tlv->type != 0x00) && (tlv->type != 0xFF));
+}
+
+static inline int is_valid_tlvinfo_header(tlvinfo_header_t *hdr)
+{
+    int max_size = PRODUCT_EEPROM_LEN;
+    return((strcmp(hdr->signature, TLV_INFO_ID_STRING) == 0) &&
+	   (hdr->version == TLV_INFO_VERSION) &&
+	   (be16_to_cpu(hdr->totallen) <= max_size) );
+}
+
+/* Strip out Spaces and carriage returns */
+static void delete_space_lf_cr(char *str)
+{
+    int i, j;
+    int len;
+
+    if (str == NULL) {
+        ast_debug( "param error, str is NULL\n");
+        return;
+    }
+    /* Remove all Spaces from the configuration line */
+    len = strlen(str);
+    for (i = 0; i < len; i++) {
+        if (str[i] == '\r' || str[i] == '\n' || str[i] == ' ') {
+            for (j = i; j < len - 1; j++) {
+                str[j] = str[j + 1];
+            }
+            str[j] = '\0';
+            len--;
+            i--;
+        }
+    }
+}
