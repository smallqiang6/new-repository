+static int get_product_name(eeprom_list_t *tmp_eeprom_list, dev_info_t **dev_info)
+{
+    struct udevice *bus, *e2_dev, *pca9641_dev;
+    int ret = -1;
+
+    ast_debug("get_product_name: bus = %d, addr = 0x%x \n", tmp_eeprom_list->bus, tmp_eeprom_list->addr);
+
+    uclass_get_device_by_seq(UCLASS_I2C, tmp_eeprom_list->bus, &bus);
+    ret = i2c_get_chip(bus, tmp_eeprom_list->addr, 1, &e2_dev);
+    if (ret) {
+        ast_debug("get eeprom chip failed, bus: %d, addr: 0x%x, ret: %d\n",
+            tmp_eeprom_list->bus, tmp_eeprom_list->addr, ret);
+        return -1;
+    }
+    ast_debug("get eeprom chip success\n");
+
+    if (tmp_eeprom_list->is_pca9641 == IS_PCA9641) {
+        ret = i2c_get_chip(bus, PCA9641_ADDR, 1, &pca9641_dev);
+        if (ret) {
+            ast_debug("get pca9641 chip failed, bus: %d, addr: 0x%x, ret: %d\n",
+                tmp_eeprom_list->bus, PCA9641_ADDR, ret);
+            return -1;
+        }
+        ast_debug("get pca9641 chip success\n");
+        ret = pca9641_get_eeprom(pca9641_dev, e2_dev, tmp_eeprom_list->addr);
+    } else {
+        ret = normal_get_eeprom(e2_dev, tmp_eeprom_list->addr);
+    }
+
+    if (ret < 0) {
+        ast_debug("Failed to read eeprom.\n");
+        return ret;
+    }
+
+    /* wedge eeprom magic */
+    if ((eeprom[0] == 0xfb) && (eeprom[1] == 0xfb)) {
+        ret = get_dev_info_from_wedge_eeprom(eeprom, dev_info);
+    } else {
+        ret = get_dev_info_from_tlv_eeprom(eeprom, dev_info);
+    }
+
+    return ret;
+}
+
+static int save_mac_addr(dev_info_t *dev_info, char *env_mac_name)
+{
+    char mac_addr_str[PRODUCT_INFO_LEN];
+    char *p_mac_addr;
+
+    memset(mac_addr_str, 0, sizeof(mac_addr_str));
+    if (dev_info->mac_addr_valid_flag) {
+        snprintf(mac_addr_str, sizeof(mac_addr_str), "%pM", dev_info->mac_addr);
+        p_mac_addr = env_get(env_mac_name);
+        if ((p_mac_addr == NULL) || (strcmp(p_mac_addr, mac_addr_str) != 0)) {
+            env_set(env_mac_name, mac_addr_str);
+            ast_debug("Set %s to flash env...\n", env_mac_name);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static void save_product_name(dev_info_t *dev_info)
+{
+    u32 len;
+    char fit[PRODUCT_INFO_LEN];
+    char board_id_str[PRODUCT_INFO_LEN];
+    char *env_product, *save_flag, *fit_name, *def_fit_name, *p_board_id, *env_eth_prime;
+    int is_save_flag;
+    int i;
+    char *debug_product;
+
+    /* ......productname . conffitname */
+    debug_product = env_get(ENV_PRODUCT_DEBUG);
+    if (debug_product != NULL && (strcmp(debug_product, ENV_PRODUCT_DEBUG_VAL) == 0)) {
+        printf("Debug mode...\n");
+        return;
+    }
+
+    if (dev_info == NULL) {
+        printf("dev_info is NULL, can't get product info.\n");
+        return;
+    }
+
+    is_save_flag = 0;
+    /* productname.. */
+    env_product = env_get(ENV_PRODUCT_NAME);
+    if (env_product == NULL || strcmp(dev_info->dev_name, env_product) != 0) {
+        env_set(ENV_PRODUCT_NAME, dev_info->dev_name);
+        env_set(ENV_PRODUCT_FLAG_NAME, ENV_PRODUCT_FLAG_VAL);
+        is_save_flag = 1;
+    } else {
+        save_flag = env_get(ENV_PRODUCT_FLAG_NAME);
+        if (strcmp(save_flag, ENV_PRODUCT_FLAG_VAL) == 0) {
+            env_set(ENV_PRODUCT_FLAG_NAME, ENV_PRODUCT_NO_FLAG_VAL);
+            is_save_flag = 1;
+        }
+    }
+
+    /* conffitname.. */
+    def_fit_name = dev_info->conffit_name;
+    memset(fit, 0, PRODUCT_INFO_LEN);
+    len = (strlen(def_fit_name) >= PRODUCT_INFO_LEN) ? (PRODUCT_INFO_LEN - 1) : strlen(def_fit_name);
+    for (i = 0; i < len; i++) {
+        if (def_fit_name[i] >= 'A' && def_fit_name[i] <= 'Z') {
+            fit[i] = def_fit_name[i] + 32;
+        } else {
+            fit[i] = def_fit_name[i];
+        }
+    }
+    fit_name = env_get(ENV_CONF_FIT_NAME);
+    if (fit_name == NULL || strcmp(fit, fit_name) != 0) {
+        env_set(ENV_CONF_FIT_NAME, fit);
+        is_save_flag = 1;
+    }
+
+    /* board_id */
+    memset(board_id_str, 0, sizeof(board_id_str));
+    snprintf(board_id_str, sizeof(board_id_str), "0x%x", dev_info->dev_type);
+    p_board_id = env_get(ENV_BOARD_ID);
+    if (p_board_id == NULL || strcmp(p_board_id, board_id_str) != 0) {
+        env_set(ENV_BOARD_ID, board_id_str);
+        is_save_flag = 1;
+    }
+
+    /* mac addr */
+    if (save_mac_addr(dev_info, ENV_MAC_ADDR)) {
+        is_save_flag = 1;
+    }
+
+    /* mac0 addr */
+    if (save_mac_addr(dev_info, ENV_MAC0_ADDR)) {
+        is_save_flag = 1;
+    }
+    /* mac1 addr */
+    if (save_mac_addr(dev_info, ENV_MAC1_ADDR)) {
+        is_save_flag = 1;
+    }
+
+    /* eth prime */
+    env_eth_prime = env_get(ENV_ETH_PRIME);
+    if (env_eth_prime == NULL || strcmp(dev_info->eth_prime, env_eth_prime) != 0) {
+        env_set(ENV_ETH_PRIME, dev_info->eth_prime);
+        is_save_flag = 1;
+    }
+
+    if (is_save_flag) {
+        ast_debug("save_env\n");
+        env_save();
+    }
+}
+
+static void product_name_match(void)
+{
+    int i;
+    int ret = -1;
+    char *env_board_id;
+    dev_info_t *dev_info;
+    unsigned long board_id;
+
+    dev_info =NULL;
+    for (i = 0; i < (sizeof(g_eeprom_list) / sizeof(eeprom_list_t)); i++) {
+        ret = get_product_name(&g_eeprom_list[i], &dev_info);
+        if (ret >= 0) {
+            ast_debug("match ok, board_id: 0x%x, productname: %s, conffitname: %s\n",
+                dev_info->dev_type, dev_info->dev_name, dev_info->conffit_name);
+            break;
+        }
+    }
+
+    if (ret < 0) {
+        env_board_id = env_get(ENV_BOARD_ID);
+        if (env_board_id == NULL) {
+            printf("Failed to get product from eeprom\nSet default product: %s\n", g_dev_info_list[0].dev_name);
+            /* read board id failed, default load g_dev_info_list[0] */
+            dev_info = &g_dev_info_list[0];
+        } else { /* ENV have board ID */
+            /* board ID match dev_info */
+            board_id = simple_strtoul(env_board_id, NULL, 16);
+            printf("Get board id from env, board_id: 0x%lx\n", board_id);
+            for (i = 0; i < (sizeof(g_dev_info_list) / sizeof(dev_info_t)); i++) {
+                if (g_dev_info_list[i].dev_type == board_id) {
+                    /* board id match */
+                    dev_info = &g_dev_info_list[i];
+                    break;
+                }
+            }
+        }
+    }
+
+    save_product_name(dev_info);
+    g_dev_info = dev_info;
+    return;
+}
+
+static void set_mac_txrx_delay(void)
+{
+    u32 value;
+    int txdelay, rxdelay;
+
+    if (g_dev_info == NULL) {
+        return;
+    }
+
+    txdelay = g_dev_info->tx_delay;
+    rxdelay = g_dev_info->rx_delay;
+    if ((txdelay < 0) || (txdelay > 63) || (rxdelay < 0) || (rxdelay > 63)) {
+        return;
+    }
+
+    value = __raw_readl(SCU_BASE + SCU_48);
+    value = (value & ~(DELAY_MASK << SCU48_MAC2_TXDELAY_MASK)) & ~(DELAY_MASK << SCU48_MAC2_RXDELAY_MASK);
+    value = (value | (txdelay << SCU48_MAC2_TXDELAY_MASK)) | (rxdelay << SCU48_MAC2_RXDELAY_MASK);
+    __raw_writel(value, SCU_BASE + SCU_48);
+    value = __raw_readl(SCU_BASE + SCU_48);
+    return;
+}
+
+int board_late_init(void)
+{
+    product_name_match();
+    set_mac_txrx_delay();
+    return 0;
+}
