@@ -0,0 +1,1139 @@
+#include <common.h>
+#include <asm/io.h>
+#include <environment.h>
+#include <i2c.h>
+#include <dm/uclass.h>
+#include <fdt_support.h>
+#include <platform_common_module.h>
+#include <configs/product_info.h>
+
+u8 eeprom[PRODUCT_EEPROM_LEN];
+
+typedef struct product_map_s {
+    char productname[PRODUCT_INFO_LEN];
+    char fitname[PRODUCT_INFO_LEN];
+} product_map_t;
+
+product_map_t fit_product_list[] = {
+    {"NONE", "none"},
+};
+static dev_info_t *g_dev_info = NULL;
+
+static u8 calculate_crc(const u8 *data, int len)
+{
+    char crc;
+    int byte;
+
+    crc = 0;
+    for(byte = 0; byte < len; byte++) {
+        crc += *data++;
+    }
+
+    return (-crc);
+}
+
+static inline int _a2v(const uint8_t *a)
+{
+  uint8_t v = *a;
+
+  if ('0' <= v && v <= '9') {
+    return v - '0';
+  }
+  if ('a' <= v && v <= 'f') {
+    return v - 'a' + 10;
+  }
+  if ('A' <= v && v <= 'F') {
+    return v - 'A' + 10;
+  }
+  return -1;
+}
+
+static inline int is_valid_tlv(tlvinfo_tlv_t *tlv)
+{
+    return ((tlv->type != 0x00) && (tlv->type != 0xFF));
+}
+
+static inline int is_valid_tlvinfo_header(tlvinfo_header_t *hdr)
+{
+    int max_size = PRODUCT_EEPROM_LEN;
+    return((strcmp(hdr->signature, TLV_INFO_ID_STRING) == 0) &&
+	   (hdr->version == TLV_INFO_VERSION) &&
+	   (be16_to_cpu(hdr->totallen) <= max_size) );
+}
+
+/* Strip out Spaces and carriage returns */
+static void delete_space_lf_cr(char *str)
+{
+    int i, j;
+    int len;
+
+    if (str == NULL) {
+        ast_debug( "param error, str is NULL\n");
+        return;
+    }
+    /* Remove all Spaces from the configuration line */
+    len = strlen(str);
+    for (i = 0; i < len; i++) {
+        if (str[i] == '\r' || str[i] == '\n' || str[i] == ' ') {
+            for (j = i; j < len - 1; j++) {
+                str[j] = str[j + 1];
+            }
+            str[j] = '\0';
+            len--;
+            i--;
+        }
+    }
+}
+
+static uint64_t mac_to_uint64(u_int8_t *mac_addr)
+{
+    return ((uint64_t)mac_addr[0] << 40) |
+           ((uint64_t)mac_addr[1] << 32) |
+           ((uint64_t)mac_addr[2] << 24) |
+           ((uint64_t)mac_addr[3] << 16) |
+           ((uint64_t)mac_addr[4] << 8) |
+           (uint64_t)mac_addr[5];
+}
+
+static void uint64_to_mac(uint64_t value, u_int8_t *mac_addr)
+{
+    mac_addr[0] = (value >> 40) & 0xFF;
+    mac_addr[1] = (value >> 32) & 0xFF;
+    mac_addr[2] = (value >> 24) & 0xFF;
+    mac_addr[3] = (value >> 16) & 0xFF;
+    mac_addr[4] = (value >> 8)  & 0xFF;
+    mac_addr[5] = value & 0xFF;
+}
+
+static void calc_bmc_mac(u_int8_t *mac_addr, int mac_increased)
+{
+    u64 base_mac_value, bmc_mac_value;
+
+    base_mac_value = mac_to_uint64(mac_addr);
+    ast_debug("mac[0]: 0x%02x, mac[1]: 0x%02x, mac[2]: 0x%02x, mac[3]: 0x%02x, mac[4]: 0x%02x, mac[5]: 0x%02x\n",
+        mac_addr[0], mac_addr[1], mac_addr[2], mac_addr[3], mac_addr[4], mac_addr[5]);
+    ast_debug("mac_increased: %d, base_mac_value: 0x%llx\n", mac_increased, base_mac_value);
+
+    bmc_mac_value = base_mac_value + mac_increased;
+    uint64_to_mac(bmc_mac_value, mac_addr);
+    ast_debug("bmc_mac_value: 0x%llx\n", bmc_mac_value);
+    ast_debug("mac[0]: 0x%02x, mac[1]: 0x%02x, mac[2]: 0x%02x, mac[3]: 0x%02x, mac[4]: 0x%02x, mac[5]: 0x%02x\n",
+        mac_addr[0], mac_addr[1], mac_addr[2], mac_addr[3], mac_addr[4], mac_addr[5]);
+    return;
+}
+
+static int decode_tlv_value(tlvinfo_tlv_t *tlv, tlv_decode_value_t *decode_value)
+{
+    char *value;
+    u_int32_t length;
+
+    length = 0;
+    value = (char *)decode_value->value;
+
+    switch (tlv->type) {
+    case TLV_CODE_PRODUCT_NAME:
+    case TLV_CODE_MAC_BASE:
+        if (tlv->length >= PRODUCT_INFO_LEN) {
+            length = PRODUCT_INFO_LEN - 1;
+        } else {
+            length = tlv->length;
+        }
+        memcpy(value, tlv->value, length);
+        value[length] = 0;
+        break;
+    default:
+        printf("Error tlv type: %d.\n", tlv->type);
+        return -1;
+    }
+
+    decode_value->length = length;
+    return 0;
+}
+
+static void ext_cmd_decode_tlv_value(tlvinfo_tlv_t *tlv, tlv_decode_value_t *decode_value)
+{
+    char *value;
+    u_int32_t length;
+
+    length = 0;
+    value = (char *)decode_value->value;
+
+    switch (tlv->type) {
+    case TLV_CODE_EXT_CARD_ID:
+        if (tlv->length >= PRODUCT_INFO_LEN) {
+            length = PRODUCT_INFO_LEN - 1;
+        } else {
+            length = tlv->length;
+        }
+        memcpy(value, tlv->value, length);
+        value[length] = 0;
+    	break;
+    default:
+        printf("Error tlv type: %d.\n", tlv->type);
+        break;
+    }
+
+    decode_value->length = length;
+}
+
+static int is_checksum_valid(u_int8_t *eeprom)
+{
+    tlvinfo_header_t *eeprom_hdr;
+    tlvinfo_tlv_t *eeprom_crc;
+    unsigned int calc_crc;
+    unsigned int stored_crc;
+
+    eeprom_hdr = (tlvinfo_header_t *) eeprom;
+
+    // Is the eeprom header valid?
+    if (!is_valid_tlvinfo_header(eeprom_hdr)) {
+	    return -1;
+    }
+
+    // Is the last TLV a CRC?
+    eeprom_crc = (tlvinfo_tlv_t *) &eeprom[sizeof(tlvinfo_header_t) +
+        be16_to_cpu(eeprom_hdr->totallen) - (sizeof(tlvinfo_tlv_t) + 4)];
+    if ((eeprom_crc->type != TLV_CODE_CRC_32) || (eeprom_crc->length != 4)) {
+	    return -1;
+    }
+
+    // Calculate the checksum
+    calc_crc = crc32(0xffffffffL, (const unsigned char *)eeprom, sizeof(tlvinfo_header_t) +
+		     be16_to_cpu(eeprom_hdr->totallen) - 4);
+    stored_crc = ((eeprom_crc->value[0] << 24) | (eeprom_crc->value[1] << 16) |
+		  (eeprom_crc->value[2] <<  8) | eeprom_crc->value[3]);
+    if (calc_crc != stored_crc) {
+        return -1;
+    }
+
+    return 0;
+}
+
+static int tlvinfo_find_tlv(u_int8_t *eeprom, u_int8_t tcode, int *eeprom_index)
+{
+    tlvinfo_header_t *eeprom_hdr;
+    tlvinfo_tlv_t    *eeprom_tlv;
+    int eeprom_end;
+
+    eeprom_hdr = (tlvinfo_header_t *) eeprom;
+
+    // Search through the TLVs, looking for the first one which matches the
+    // supplied type code.
+    *eeprom_index = sizeof(tlvinfo_header_t);
+    eeprom_end = sizeof(tlvinfo_header_t) + be16_to_cpu(eeprom_hdr->totallen);
+    while (*eeprom_index < eeprom_end) {
+	    eeprom_tlv = (tlvinfo_tlv_t *) &eeprom[*eeprom_index];
+	    if (!is_valid_tlv(eeprom_tlv)) {
+            return -1;
+	    }
+
+        if (eeprom_tlv->type == tcode) {
+	        return 0;
+	    }
+
+	    *eeprom_index += sizeof(tlvinfo_tlv_t) + eeprom_tlv->length;
+    }
+
+    return -1;
+}
+
+static int tlvinfo_find_tlv_ext(tlvinfo_tlv_t *ext_eeprom, u_int8_t extcode, int *ext_eeprom_index)
+{
+    tlvinfo_tlv_t    *ext_eeprom_tlv;
+
+    // Search through the TLVs, looking for the first one which matches the
+    // supplied type code.
+    while (*ext_eeprom_index < ext_eeprom->length) {
+	    ext_eeprom_tlv = (tlvinfo_tlv_t *) &(ext_eeprom->value)[*ext_eeprom_index];
+	    if (!is_valid_tlv(ext_eeprom_tlv)) {
+            return -1;
+	    }
+
+        if (ext_eeprom_tlv->type == extcode) {
+	        return 0;
+	    }
+
+	    *ext_eeprom_index += sizeof(tlvinfo_tlv_t) + ext_eeprom_tlv->length;
+    }
+
+    return -1;
+}
+
+static int tlvinfo_decode_tlv(u_int8_t *eeprom, u_int8_t tcode, u_int8_t extcode, tlv_decode_value_t *decode_value)
+{
+    int eeprom_index = 0;
+    int ext_eeprom_index = 0;
+    tlvinfo_tlv_t *eeprom_tlv;
+    tlvinfo_tlv_t *ext_eeprom_tlv;
+
+    if (tcode == TLV_CODE_VENDOR_EXT) {
+        if (tlvinfo_find_tlv(eeprom, tcode, &eeprom_index) == 0) {
+            eeprom_tlv = (tlvinfo_tlv_t *) &eeprom[eeprom_index];
+            if (tlvinfo_find_tlv_ext(eeprom_tlv, extcode, &ext_eeprom_index) == 0) {
+                ext_eeprom_tlv = (tlvinfo_tlv_t *) &((eeprom_tlv->value)[ext_eeprom_index]);
+                ext_cmd_decode_tlv_value(ext_eeprom_tlv, decode_value);
+                return 0;
+            }
+            return 0;
+        }
+    } else {
+        // Find the TLV and then decode it
+        if (tlvinfo_find_tlv(eeprom, tcode, &eeprom_index) == 0) {
+            eeprom_tlv = (tlvinfo_tlv_t *) &eeprom[eeprom_index];
+            return decode_tlv_value(eeprom_tlv, decode_value);
+        }
+    }
+
+    return -1;
+}
