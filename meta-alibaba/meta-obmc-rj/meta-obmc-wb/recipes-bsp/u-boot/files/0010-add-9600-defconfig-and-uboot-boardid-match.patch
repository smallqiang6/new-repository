+    u_int8_t mac_addr[MAC_ADDR_LENGTH];
+    int mac_addr_valid_flag;
+
+    /* get dev_info by product id */
+    ret = get_product_id_from_tlv_eeprom(eeprom, &product_id);
+    if (ret < 0) {
+        return -1;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(g_dev_info_list); i++) {
+        if (product_id == g_dev_info_list[i].dev_type) {
+            *dev_info = &g_dev_info_list[i];
+            break;
+        }
+    }
+
+    if (i == ARRAY_SIZE(g_dev_info_list)) {
+        printf("Product id: 0x%lx not found in dev_info_list.\n", product_id);
+        return -1;
+    }
+
+    /* onie-tlv eeprom match product name */
+    memset((*dev_info)->syseeprom_type, 0, sizeof((*dev_info)->syseeprom_type));
