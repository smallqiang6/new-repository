+static int get_mac_from_fru_eeprom(u_int8_t *eeprom, u_int8_t *buf, u_int32_t size, int fru_mac_extra_index)
+{
+    int offset;
+    int i;
+    u32 len;
+
+    offset = eeprom[IPMI_FRU_PRODUCT_OFFSET] * 8;
+    /* skip Product Area Format Version, Product Area Length and Language Code */
+    offset += 3;
+    for (i = 0; i < (IPMI_FRU_PRODUCT_AREA_MIN_LEN + fru_mac_extra_index); i++) {
+        if ((eeprom[offset] == IPMI_FRU_SENTINEL_VALUE) && (i >= IPMI_FRU_PRODUCT_AREA_MIN_LEN)) {
+            printf("Not found mac address from fru eeprom, fru product area mac extra index: %d.\n",
+                fru_mac_extra_index);
+            return -1;
+        }
+
+        len = (eeprom[offset] & (~IPMI_FRU_TYPE_LENGTH_TYPE_CODE_MASK)) & 0xff;
+        if ((i + 1) == (IPMI_FRU_PRODUCT_AREA_MIN_LEN + fru_mac_extra_index)) {
+            if (len != MAC_ADDR_LENGTH) {
+                printf("Invalid mac address length: %d, fru product area mac extra index: %d.\n",
+                    len, fru_mac_extra_index);
+                return -1;
+            }
+            memcpy(buf, &(eeprom[offset + 1]), size);
+            return 0;
+        }
+        offset += 1;
+        offset += len;
+    }
+
+    printf("Not found mac address from fru eeprom, fru product area mac extra index: %d.\n",
+        fru_mac_extra_index);
+    return -1;
+}
