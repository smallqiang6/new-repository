+static int get_fru_info(char *fru_info, int fru_len, int fru_offset)
+{
+    int offset;
+    u32 len;
+    int i;
+
+    /* Get product area start offset */
+    offset = eeprom[IPMI_FRU_PRODUCT_OFFSET] * 8;
+    if (offset > sizeof(eeprom)) {
+        printf("Error product fru eeprom offset: %d.\n", offset);
+        return -1;
+    }
+
+    /* FRU porduct area skip 3-bytes to get product name directly */
+    offset += 3;
+    for (i = 0; i < fru_offset; i++) {
+        if ((eeprom[offset] == IPMI_FRU_SENTINEL_VALUE) && (i >= IPMI_FRU_PRODUCT_AREA_MIN_LEN)) {
+            printf("No found fru info.\n");
+            return -1;
+        }
+
+        len = (eeprom[offset] & (~IPMI_FRU_TYPE_LENGTH_TYPE_CODE_MASK)) & 0xff;
+        if ((i + 1) == fru_offset) {
+            if (len >= fru_len) {
+                printf("Error: length: %d\n", len);
+                len = fru_len - 1;
+            }
+            memcpy((void *)fru_info, &(eeprom[offset + 1]), len);
+            return 0;
+        }
+
+        offset += len;
+        offset += 1;
+    }
+
+    printf("End, No found fru_info.\n");
+    return -1;
+}
