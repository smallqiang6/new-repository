+    memset((void *)&decode_value, 0, sizeof(tlv_decode_value_t));
+    ret = tlvinfo_decode_tlv(eeprom, TLV_CODE_MAC_BASE, TLV_CODE_EXT_NO_CMD, &decode_value);
+    if (ret != 0) {
+        ast_debug("No found MAC address\n");
+        return -1;
+    }
+
+    if (decode_value.length != size) {
+        printf("Invalid mac addr size: %d.\n", decode_value.length);
