-static inline int _a2v(const uint8_t *a)
-{
-  uint8_t v = *a;
-
-  if ('0' <= v && v <= '9') {
-    return v - '0';
-  }
-  if ('a' <= v && v <= 'f') {
-    return v - 'a' + 10;
-  }
-  if ('A' <= v && v <= 'F') {
-    return v - 'A' + 10;
-  }
-  return -1;
-}
