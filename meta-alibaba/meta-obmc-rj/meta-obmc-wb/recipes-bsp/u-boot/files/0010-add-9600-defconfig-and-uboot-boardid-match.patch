-static uint64_t mac_to_uint64(u_int8_t *mac_addr)
-{
-    return ((uint64_t)mac_addr[0] << 40) |
-           ((uint64_t)mac_addr[1] << 32) |
-           ((uint64_t)mac_addr[2] << 24) |
-           ((uint64_t)mac_addr[3] << 16) |
-           ((uint64_t)mac_addr[4] << 8) |
-           (uint64_t)mac_addr[5];
-}
-
-static void uint64_to_mac(uint64_t value, u_int8_t *mac_addr)
-{
-    mac_addr[0] = (value >> 40) & 0xFF;
-    mac_addr[1] = (value >> 32) & 0xFF;
-    mac_addr[2] = (value >> 24) & 0xFF;
-    mac_addr[3] = (value >> 16) & 0xFF;
-    mac_addr[4] = (value >> 8)  & 0xFF;
-    mac_addr[5] = value & 0xFF;
-}
