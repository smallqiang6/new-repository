+static int get_mac_from_wedge_eeprom(u_int8_t *eeprom, u_int8_t *buf, u_int32_t size)
+{
+    int i, a2v_tmp1, a2v_tmp2;
+    const uint8_t *cur = &eeprom[FBW_EEPROM_F_LOCAL_MAC_OFFSET];
+
+    if (size < MAC_ADDR_LENGTH) {
+        ast_debug("mac size buf %d is less than 6\n", size)
+        return -1;
+    }
+
+    for (i = 0; i < MAC_ADDR_LENGTH; i++) {
+        a2v_tmp1 = _a2v(cur);
+        a2v_tmp2 = _a2v(cur + 1);
+        if ((a2v_tmp1 < 0) || (a2v_tmp2 < 0)) {
+            printf("Invalid mac address ASCII, index: %d, value: 0x%02x, 0x%02x\n", i * 2, cur[0], cur[1]);
+            return -1;
+        }
+        *buf = ((a2v_tmp1 << 4) | a2v_tmp2) & 0xff;
+        buf++;
+        cur += 2;
+    }
+    return 0;
+}
