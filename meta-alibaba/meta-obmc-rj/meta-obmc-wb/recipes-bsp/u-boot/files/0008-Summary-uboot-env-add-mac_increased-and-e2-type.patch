+    ast_debug("mac_increased: %d, base_mac_value: 0x%llx\n", mac_increased, base_mac_value);
+
+    bmc_mac_value = base_mac_value + mac_increased;
+    uint64_to_mac(bmc_mac_value, mac_addr);
+    ast_debug("bmc_mac_value: 0x%llx\n", bmc_mac_value);
+    ast_debug("mac[0]: 0x%02x, mac[1]: 0x%02x, mac[2]: 0x%02x, mac[3]: 0x%02x, mac[4]: 0x%02x, mac[5]: 0x%02x\n",
+        mac_addr[0], mac_addr[1], mac_addr[2], mac_addr[3], mac_addr[4], mac_addr[5]);
     return;
 }
 
