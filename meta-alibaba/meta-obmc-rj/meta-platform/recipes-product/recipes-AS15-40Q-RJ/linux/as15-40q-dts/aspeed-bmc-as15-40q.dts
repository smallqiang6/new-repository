/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>

/ {
    model = "AS15-40Q-RJ";
    compatible = "aspeed,ast2600";

    aliases {
        serial4 = &uart5;
    };

    chosen {
        bootargs = "console=ttyS4,9600n8";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x80000000>;
    };

    vcc_sdhci0: regulator-vcc-sdhci0 {
        compatible = "regulator-fixed";
        regulator-name = "SDHCI0 Vcc";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        gpios = <&gpio0 ASPEED_GPIO(V, 0) GPIO_ACTIVE_HIGH>;
        enable-active-high;
    };

    vccq_sdhci0: regulator-vccq-sdhci0 {
        compatible = "regulator-gpio";
        regulator-name = "SDHCI0 VccQ";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <3300000>;
        gpios = <&gpio0 ASPEED_GPIO(V, 1) GPIO_ACTIVE_HIGH>;
        gpios-states = <1>;
        states = <3300000 1>,<1800000 0>;
    };

    vcc_sdhci1: regulator-vcc-sdhci1 {
        compatible = "regulator-fixed";
        regulator-name = "SDHCI1 Vcc";
        regulator-min-microvolt = <3300000>;
        regulator-max-microvolt = <3300000>;
        gpios = <&gpio0 ASPEED_GPIO(V, 2) GPIO_ACTIVE_HIGH>;
        enable-active-high;
    };

    vccq_sdhci1: regulator-vccq-sdhci1 {
        compatible = "regulator-gpio";
        regulator-name = "SDHCI1 VccQ";
        regulator-min-microvolt = <1800000>;
        regulator-max-microvolt = <3300000>;
        gpios = <&gpio0 ASPEED_GPIO(V, 3) GPIO_ACTIVE_HIGH>;
        gpios-states = <1>;
        states = <3300000 1>,<1800000 0>;
    };

    peci: peci@1e78b000 {
        compatible = "aspeed,ast2600-peci";
        reg = <0x1e78b000 0x100>;
        interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
    };

    spi_gpio {
        compatible = "spi-gpio";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;
        num-chipselects = <2>;

        gpio-sck = <&gpio0 ASPEED_GPIO(P, 1) 0>;
        gpio-mosi = <&gpio0 ASPEED_GPIO(P, 3) 0>;
        gpio-miso = <&gpio0 ASPEED_GPIO(P, 2) 0>;
        cs-gpios = <
            &gpio0 ASPEED_GPIO(P, 4) 0
            &gpio0 ASPEED_GPIO(Q, 7) 1
        >;

    };

    /* CPU_CPLD */
    firmware_cpld0 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <885>;
        en_level_0 = <1>;
        en_logic_dev_0 = "/dev/cpld1";
        en_logic_addr_0 = <0xf3>;
        en_logic_mask_0 = <0x00>;
        en_logic_en_val_0 = <0xfe>;
        en_logic_dis_val_0 = <0xff>;
        en_logic_width_0 = <1>;
        chain       = <1>;
        chip_index  = <1>;
    };

    /* BASE_CPLD */
    firmware_cpld1 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <886>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <1>;
        chain       = <2>;
        chip_index  = <1>;
    };

    /* MAC CPLDA */
    firmware_cpld2 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <885>;
        en_level_0 = <1>;
        en_logic_dev_0 = "/dev/cpld1";
        en_logic_addr_0 = <0xf3>;
        en_logic_mask_0 = <0x00>;
        en_logic_en_val_0 = <0xeb>;
        en_logic_dis_val_0 = <0xff>;
        en_logic_width_0 = <1>;
        chain       = <3>;
        chip_index  = <1>;
    };

    /* FCB CPLD */
    firmware_cpld3 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <885>;
        en_level_0 = <1>;
        en_logic_dev_0 = "/dev/cpld1";
        en_logic_addr_0 = <0xf3>;
        en_logic_mask_0 = <0x00>;
        en_logic_en_val_0 = <0xfd>;
        en_logic_dis_val_0 = <0xff>;
        en_logic_width_0 = <1>;
        chain       = <4>;
        chip_index  = <1>;
    };

    /* MISC CPLD */
    firmware_cpld4 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <885>;
        en_level_0 = <1>;
        en_logic_dev_0 = "/dev/cpld1";
        en_logic_addr_0 = <0xf3>;
        en_logic_mask_0 = <0x00>;
        en_logic_en_val_0 = <0xfb>;
        en_logic_dis_val_0 = <0xff>;
        en_logic_width_0 = <1>;
        chain       = <5>;
        chip_index  = <1>;
    };

    /* 53134 Upgrading a link */
    firmware_bcm53134 {
        compatible  = "firmware_sysfs";
        type        = "SYSFS";
        chain       = <1>;
        chip_index  = <1>;
        sysfs_name  = "/sys/bus/spi/devices/spi0.0/eeprom";
        en_gpio_0   = <941>;    /* GPION5 Enable online upgrade of BCM53134O */
        en_level_0  = <0>;
    };
    
    /* FPGA Upgrading a link */
    firmware_fpga0_up {
        compatible  = "firmware_sysfs";
        type        = "MTD_DEV";
        chain       = <2>;
        chip_index  = <1>;
        mtd_name    = "spi0.1";
        flash_base  = <0x200000>;
        test_base   = <0x7F0000>;
        test_size   = <0x10000>;
    };
    
    /* FPGA Upgrade the link chip */
    firmware_fpga0_shaopian {
        compatible  = "firmware_sysfs";
        type        = "MTD_DEV";
        chain       = <3>;
        chip_index  = <1>;
        mtd_name    = "spi0.1";
        flash_base  = <0x0>;
        test_base   = <0x7F0000>;
        test_size   = <0x10000>;
    };

    /* BIOS Upgrading a link */
    firmware_bios {
        compatible  = "firmware_sysfs";
        type        = "MTD_DEV";
        chain       = <4>;
        chip_index  = <1>;
        mtd_name    = "BIOS";
        flash_base  = <0x0>;
    };

    /* MAC flash Upgrading a link */
    firmware_mac {
        compatible  = "firmware_sysfs";
        type        = "MTD_DEV";
        chain       = <5>;
        chip_index  = <1>;
        mtd_name    = "spi0.1";
        flash_base  = <0>;
    };


    wb_mmc_resume@0 {
        compatible = "dev_resume_drv";
        dev_type   = <1>;                             /* 1: MMC; 2: SSD */
        slot_id    = <0>;                             /* emmc controller0 */
        bit_mask   = <0x01>;
        reg_intf_name   = "mmc_resume_register";
        unreg_intf_name = "mmc_resume_unregister";

        resume_way0 {
            resume_way    = <3>;                     /* way3 DEV_RESUME_WAY2_CTL_GPIO */
            gpio_num      = <986>;
            active_level  = <0>;
            reset_delay   = <80000>;
            dereset_delay = <5000>;
        };
    };


};

&mdio0 {
    status = "disabled";
};

&mdio1 {
    status = "disabled";
};

&mdio2 {
    status = "okay";

    ethphy0: ethernet-phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0>;
    };
    ethphy1: ethernet-phy@1 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <1>;
    };
    ethphy2: ethernet-phy@2 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <2>;
    };
    ethphy3: ethernet-phy@3 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <3>;
    };
    ethphy4: ethernet-phy@4 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x11>;
    };
    ethphy6: ethernet-phy@6 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x1e>;
    };
    ethphy7: ethernet-phy@7 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0x1f>;
    };
};

&mdio3 {
    status = "disabled";
};

&mac0 {
    status = "disabled";
};

&mac1 {
    status = "disabled";
};

&mac2 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rgmii3_default>;
    phy-handle;
    phy-mode = "rgmii";
    fixed-link {
        speed = <1000>;
        full-duplex;
    };
};

&mac3 {
    status = "disabled";
};

&emmc_controller {
    status = "okay";
};

&emmc {
	bus-width = <8>;
	pinctrl-0 = <&pinctrl_emmcg8_default>;
 	non-removable;
	no-sd;
	no-sdio;
 	max-frequency = <50000000>;
	clk-phase-mmc-hs200 = <0 27>, <1 185>;
	cap-mmc-hw-reset;
    reset_gpio = <794>; /* reset emmc gpio GPIOB6*/
	reset_on = <0>;
	reset_off = <1>;
    status = "okay";
 };

&fmc {
    status = "okay";
    flash@0 {
    status = "okay";
        m25p,fast-read;
        label = "bmc";
        spi-max-frequency = <50000000>;
#include "facebook-bmc-g6-flash-layout-64.dtsi"
    };
    flash@1 {
        status = "okay";
        m25p,fast-read;
        label = "bmc-alt";
        spi-max-frequency = <50000000>;
#include "facebook-bmc-g6-alt-flash-layout-64.dtsi"
    };
};

&spi1 {
    status = "okay";
    fmc-spi-user-mode;
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_spi1_default>;

    flash@0 {
        status = "okay";
        label = "BIOS";
        m25p,fast-read;
    };
};


&uart1 {
    status = "okay";
};

&uart2 {
    status = "okay";
};

&uart3 {
    status = "okay";
};

&uart4 {
    status = "okay";
};

&uart5 {
	// Workaround for A0
	compatible = "snps,dw-apb-uart";
};

&i2c0 {
    status = "okay";
    bus-frequency = <90000>;
    base-cpld@0d {
        compatible = "wb-i2c-dev";
        reg = <0x0d>;
        i2c_name = "cpld1";
        data_bus_width = <1>;
        addr_bus_width = <1>;
        per_rd_len = <256>;
        per_wr_len = <256>;
        i2c_len = <0x100>;
    };
};

&i2c1 {
    status = "okay";
    i2cswitch@71 {
        compatible = "nxp,wb_pca9548";
        reg = <0x71>;
        probe_disable;
        pca9548_base_nr = <16>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x04>;
        reset_on = <0x00>;
        reset_off = <0x04>;
        i2c@0 {
            reg = <0>;
            cpu-cpld@0d {
                compatible = "wb-i2c-dev";
                reg = <0x0d>;
                i2c_name = "cpld0";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <256>;
                per_wr_len = <256>;
                i2c_len = <0x100>;
            };
        };
    };
};

&i2c2 {
    status = "okay";
};

&i2c3 {
    status = "okay";
    rtc@51 {
        compatible = "nxp,pcf85063a";
        reg = <0x51>;
        status = "okay";
        cap-mode = /bits/ 8 <0x00>;
        clock-freq = /bits/ 8 <0x07>;
        accuracy-value = /bits/ 8 <0x09>;
    };
};

&i2c4 {
    status = "okay";
    i2cswitch@70 {
        compatible = "nxp,wb_pca9548";
        reg = <0x70>;
        probe_disable;
        pca9548_base_nr = <24>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x01>;
        reset_on = <0x00>;
        reset_off = <0x01>;
    };
    i2cswitch@71 {
        compatible = "nxp,wb_pca9548";
        reg = <0x71>;
        probe_disable;
        pca9548_base_nr = <32>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x10>;
        reset_on = <0x00>;
        reset_off = <0x10>;
    };
    i2cswitch@72 {
        compatible = "nxp,wb_pca9548";
        reg = <0x72>;
        probe_disable;
        pca9548_base_nr = <40>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x10>;
        reset_on = <0x00>;
        reset_off = <0x10>;
    };
};

&i2c5 {
    status = "okay";
    fpga@32 {
        compatible = "wb-i2c-dev";
        reg = <0x32>;
        i2c_name = "fpga0";
        data_bus_width = <1>;
        addr_bus_width = <1>;
        per_rd_len = <1>;
        per_wr_len = <1>;
        i2c_len = <0x100>;
    };
    i2cswitch@70 {
        compatible = "nxp,wb_pca9548";
        reg = <0x70>;
        probe_disable;
        pca9548_base_nr = <48>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x20>;
        reset_on = <0x00>;
        reset_off = <0x20>;
        i2c@0 {
            reg = <0>;
            misc-cpld@30 {
                compatible = "wb-i2c-dev";
                reg = <0x30>;
                i2c_name = "cpld3";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <256>;
                per_wr_len = <256>;
                i2c_len = <0x100>;
            };
        };
        i2c@1 {
            reg = <1>;
            mac-cplda@31 {
                compatible = "wb-i2c-dev";
                reg = <0x31>;
                i2c_name = "cpld2";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <1>;
                per_wr_len = <1>;
                i2c_len = <0x100>;
            };
        };
    };
};

&i2c6 {
    status = "okay";
    i2cswitch@70 {
        compatible = "nxp,wb_pca9548";
        reg = <0x70>;
        probe_disable;
        pca9548_base_nr = <56>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x30>;
        mask = <0x01>;
        reset_on = <0x00>;
        reset_off = <0x01>;
    };
};

&i2c7 {
    status = "okay";
    i2cswitch@70 {
        compatible = "nxp,wb_pca9548";
        reg = <0x70>;
        probe_disable;
        pca9548_base_nr = <64>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x40>;
        reset_on = <0x00>;
        reset_off = <0x40>;
    };
};

&i2c8 {
    status = "okay";
    fan-cpld@0d {
        compatible = "wb-i2c-dev";
        reg = <0x0d>;
        i2c_name = "cpld4";
        data_bus_width = <1>;
        addr_bus_width = <1>;
        per_rd_len = <256>;
        per_wr_len = <256>;
        i2c_len = <0x100>;
    };
    i2cswitch@70 {
        compatible = "nxp,wb_pca9548";
        reg = <0x70>;
        probe_disable;
        pca9548_base_nr = <72>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x30>;
        mask = <0x02>;
        reset_on = <0x00>;
        reset_off = <0x02>;
    };
};

&i2c13 {
    status = "okay";
    i2cswitch@71 {
        compatible = "nxp,wb_pca9548";
        reg = <0x71>;
        probe_disable;
        pca9548_base_nr = <80>;
        status = "okay";
        pca9548_reset_type  = <1>;      /* 1:I2C 2:GPIO 3:IO 4:FILE */
        rst_delay_b = <0>;              /* delay time before reset(us) */
        rst_delay   = <1000>;           /* reset time(us) */
        rst_delay_a = <1000>;           /* delay time after reset(us) */
        i2c_bus = <0>;
        i2c_addr = <0x0d>;
        reg_offset = <0x31>;
        mask = <0x02>;
        reset_on = <0x00>;
        reset_off = <0x02>;
    };
};

&fsim0 {
    status = "okay";
};

&uhci {
    status = "disabled";
};

&sdc {
    status = "okay";
};

&edac {
    status = "disabled";
};

/*
 * The signal voltage of sdhci0 and sdhci1 on AST2600-A2 EVB is able to be
 * toggled by GPIO pins.
 * In the reference design, GPIOV0 of AST2600-A2 EVB is connected to the
 * power load switch that provides 3.3v to sdhci0 vdd, GPIOV1 is connected to
 * a 1.8v and a 3.3v power load switch that provides signal voltage to
 * sdhci0 bus.
 * If GPIOV0 is active high, sdhci0 is enabled, otherwise, sdhci0 is disabled.
 * If GPIOV1 is active high, 3.3v power load switch is enabled, sdhci0 signal
 * voltage is 3.3v, otherwise, 1.8v power load switch will be enabled,
 * sdhci0 signal voltage becomes 1.8v.
 * AST2600-A2 EVB also supports toggling signal voltage for sdhci1.
 * The design is the same as sdhci0, it uses GPIOV2 as power-gpio and GPIOV3
 * as power-switch-gpio.
 */
&sdhci0 {
    status = "okay";
    bus-width = <4>;
    max-frequency = <100000000>;
    sdhci-drive-type = /bits/ 8 <3>;
    sdhci-caps-mask = <0x7 0x0>;
    sdhci,wp-inverted;
    vmmc-supply = <&vcc_sdhci0>;
    vqmmc-supply = <&vccq_sdhci0>;
    clk-phase-sd-hs = <7>, <200>;
};

&sdhci1 {
    status = "disabled";
    bus-width = <4>;
    max-frequency = <100000000>;
    sdhci-drive-type = /bits/ 8 <3>;
    sdhci-caps-mask = <0x7 0x0>;
    sdhci,wp-inverted;
    vmmc-supply = <&vcc_sdhci1>;
    vqmmc-supply = <&vccq_sdhci1>;
    clk-phase-sd-hs = <7>, <200>;
};

&ehci0 {
    status = "disabled";
};

&ehci1 {
    status = "disabled";
};

&vhub {
    status = "okay";
};

&lpc_snoop {
    status = "okay";
    snoop-ports = <0x80 0x81>;
};

&kcs3 {
    status = "okay";
    kcs-io-addr = <0xca2>;
    kcs-channel = <3>;
};
