&i2c7 {
    status = "okay";
};

&i2c8 {
    status = "okay";
    bmc_eeprom@56 {
        compatible = "atmel,24c02";
        reg = <0x56>;
        status = "okay";
    };
    i2c-switch@72 {
        compatible = "nxp,wb_pca9548";
        #address-cells = <1>;
        #size-cells = <0>;
        pca9548_base_nr = <98>; 
        probe_disable;
        reg = <0x72>;

        i2c-bus@0 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0>;

            // MAC board CPLDA
            mac_cpld_a@1b {
                compatible = "wb-i2c-dev";
                reg = <0x1b>;
                i2c_name = "cpld7";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <256>;
                per_wr_len = <256>;
                i2c_len    = <0x100>;
            };
        };
        i2c-bus@1 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <1>;

            // MAC board CPLDB
            mac_cpld_b@2b {
                compatible = "wb-i2c-dev";
                reg = <0x2b>;
                i2c_name = "cpld8";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <256>;
                per_wr_len = <256>;
                i2c_len    = <0x100>;
            };
        };
        i2c-bus@2 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <2>;

            mac_cpld_c@3b {
                compatible = "wb-i2c-dev";
                reg = <0x3b>;
                i2c_name = "cpld9";
                data_bus_width = <1>;
                addr_bus_width = <1>;
                per_rd_len = <256>;
                per_wr_len = <256>;
                i2c_len    = <0x100>;
            };
        };
        i2c-bus@3 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <3>;

        mac_fpga@36 {
                compatible = "wb-i2c-dev";
                reg = <0x36>;
                i2c_name = "fpga1";
                data_bus_width = <4>;
                addr_bus_width = <4>;
                per_rd_len = <4>;
                per_wr_len = <4>;
                i2c_len    = <0x1000>;
            };
        };
    };
};

