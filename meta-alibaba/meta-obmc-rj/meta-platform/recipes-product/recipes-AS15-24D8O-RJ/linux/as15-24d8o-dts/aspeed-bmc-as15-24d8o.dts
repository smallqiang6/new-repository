        i2c_slave               = <0x61c>;
        i2c_reg                 = <0x620>;
        i2c_reg_len             = <0x630>;
        i2c_data_len            = <0x634>;
        i2c_ctrl                = <0x638>;
        i2c_status              = <0x63c>;
        i2c_err_vec             = <0x648>;
        i2c_data_buf            = <0x680>;
        dev_name                = "/dev/fpga0";
        i2c_scale_value         = <0x4e>;
        i2c_filter_value        = <0x7c>;
