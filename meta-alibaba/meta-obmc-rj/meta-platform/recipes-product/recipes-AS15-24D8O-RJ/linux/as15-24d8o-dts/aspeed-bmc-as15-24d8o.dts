&i2c3 {
    status = "okay";
};

&i2c4 {
    status = "okay";
};

&i2c5 {
    status = "okay";
};

&i2c6 {
    status = "okay";
    rtc@51 {
        compatible = "nxp,pcf85063a";
        reg = <0x51>;
        status = "okay";
        cap-mode = /bits/ 8 <0x00>;
        clock-freq = /bits/ 8 <0x07>;
