    ethphy3: ethernet-phy@3 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <3>;
    };
    ethphy6: ethernet-phy@6 {
        compatible = "ethernet-phy-ieee802.3-c22";
