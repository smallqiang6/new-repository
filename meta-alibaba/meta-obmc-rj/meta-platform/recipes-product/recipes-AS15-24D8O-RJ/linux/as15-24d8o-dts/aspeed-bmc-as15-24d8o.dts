        i2c_ctrl                = <0xe38>;
        i2c_status              = <0xe3c>;
        i2c_err_vec             = <0xe48>;
        i2c_data_buf            = <0xe80>;
        dev_name                = "/dev/fpga0";
        i2c_scale_value         = <0x4e>;
        i2c_filter_value        = <0x7c>;
        i2c_stretch_value       = <0x7c>;
        i2c_func_mode           = <5>;
        i2c_adap_reset_flag     = <0>;
        i2c_reset_addr          = <0x5c>;
        i2c_reset_on            = <0x00000001>;
        i2c_reset_off           = <0x00000000>;
        i2c_rst_delay_b         = <0>; /* delay time before reset(us) */
        i2c_rst_delay           = <1>; /* reset time(us) */
        i2c_rst_delay_a         = <1>; /* delay time after reset(us) */

        pca9548@70 {
            compatible = "wb_fpga_pca9541";
            reg = <0x70>;  
            #address-cells = <1>;
            #size-cells = <0>;
            pca9548_base_nr = <48>;
            fpga_9548_flag = <1>;        /* 1: internal 9548 2: external 9548 */
            fpga_9548_reset_flag = <0>;  /* 1: reset, 0: no bit */
        };
    };

    /*BASE CPLD*/
    firmware_cpld0 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <885>;
        en_level_0 = <1>;
        en_gpio_1  = <880>;
        en_level_1 = <1>;
        en_gpio_2  = <886>;
        en_level_2 = <0>;
        chain        = <1>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x2>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
    };

    /* MAC CPLD_A CPLD_B*/
    firmware_cpld1 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <880>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <0>;
        en_gpio_2  = <886>;
        en_level_2 = <1>;
        chain        = <2>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x02>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x46>;
        en_logic_mask_1 = <0xf8>;
        en_logic_en_val_1 = <0x2>;
        en_logic_dis_val_1 = <0x0>;
        en_logic_width_1 = <1>;
        en_logic_dev_2 = "/dev/cpld6";
        en_logic_addr_2 = <0x49>;
        en_logic_mask_2 = <0xfc>;
        en_logic_en_val_2 = <0x2>;
        en_logic_dis_val_2 = <0x3>;
        en_logic_width_2 = <1>;
        en_logic_dev_3 = "/dev/cpld6";
        en_logic_addr_3 = <0x4b>;
        en_logic_mask_3 = <0x00>;
        en_logic_en_val_3 = <0xfe>;
        en_logic_dis_val_3 = <0x1f>;
        en_logic_width_3 = <1>;
    };

    /*MAC CPLD_C*/
    firmware_cpld2 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <880>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <0>;
        en_gpio_2  = <886>;
        en_level_2 = <1>;
        chain        = <3>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x02>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x46>;
        en_logic_mask_1 = <0xf8>;
        en_logic_en_val_1 = <0x2>;
        en_logic_dis_val_1 = <0x0>;
        en_logic_width_1 = <1>;
        en_logic_dev_2 = "/dev/cpld6";
        en_logic_addr_2 = <0x49>;
        en_logic_mask_2 = <0xfc>;
        en_logic_en_val_2 = <0x1>;
        en_logic_dis_val_2 = <0x3>;
        en_logic_width_2 = <1>;
    };

    /* FAN CPLD*/
    firmware_cpld3 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <880>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <0>;
        en_gpio_2  = <886>;
        en_level_2 = <1>;
        chain        = <4>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x02>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x46>;
        en_logic_mask_1 = <0xf8>;
        en_logic_en_val_1 = <0x4>;
        en_logic_dis_val_1 = <0x0>;
        en_logic_width_1 = <1>;
        en_logic_dev_2 = "/dev/cpld6";
        en_logic_addr_2 = <0x49>;
        en_logic_mask_2 = <0xfc>;
        en_logic_en_val_2 = <0x2>;
        en_logic_dis_val_2 = <0x0>;
        en_logic_width_2 = <1>;
        en_logic_dev_3 = "/dev/cpld6";
        en_logic_addr_3 = <0x4b>;
        en_logic_mask_3 = <0x00>;
        en_logic_en_val_3 = <0xfd>;
        en_logic_dis_val_3 = <0xff>;
        en_logic_width_3 = <1>;
    };

    /*MGMT CPLD*/
    firmware_cpld4 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <880>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <0>;
        en_gpio_2  = <886>;
        en_level_2 = <1>;
        chain        = <5>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x2>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x46>;
        en_logic_mask_1 = <0x00>;
        en_logic_en_val_1 = <0x3>;
        en_logic_dis_val_1 = <0x0>;
        en_logic_width_1 = <1>;
        en_logic_dev_2 = "/dev/cpld6";
        en_logic_addr_2 = <0x4b>;
        en_logic_mask_2 = <0x00>;
        en_logic_en_val_2 = <0xfb>;
        en_logic_dis_val_2 = <0xff>;
        en_logic_width_2 = <1>;
        en_logic_dev_3 = "/dev/cpld6";
        en_logic_addr_3 = <0x49>;
        en_logic_mask_3 = <0xfc>;
        en_logic_en_val_3 = <0x2>;
        en_logic_dis_val_3 = <0x0>;
        en_logic_width_3 = <1>;
    };

     /* CPU CPLD*/
    firmware_cpld5 {
        compatible  = "firmware_cpld_ispvme";
        type        = "JTAG";
        tck      = <882>;
        tdi      = <881>;
        tms      = <883>;
        tdo      = <884>;
        en_gpio_0  = <880>;
        en_level_0 = <1>;
        en_gpio_1  = <885>;
        en_level_1 = <0>;
        en_gpio_2  = <886>;
        en_level_2 = <1>;
        chain        = <6>;
        chip_index  = <1>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x45>;
        en_logic_mask_0 = <0xfc>;
        en_logic_en_val_0 = <0x02>;
        en_logic_dis_val_0 = <0x0>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x46>;
        en_logic_mask_1 = <0xf8>;
        en_logic_en_val_1 = <0x1>;
        en_logic_dis_val_1 = <0x0>;
        en_logic_width_1 = <1>;
    };


    /* 53134 upgrade */
    firmware_bcm53134 {
        compatible  = "firmware_sysfs";
        type        = "SYSFS";
        chain        = <2>;
        chip_index  = <1>;
        sysfs_name    = "/sys/bus/spi/devices/spi2.0/eeprom";
        en_gpio_0  = <941>;
        en_level_0 = <0>;
        en_logic_dev_0 = "/dev/cpld6";
        en_logic_addr_0 = <0x3d>;
        en_logic_mask_0 = <0xfe>;
        en_logic_en_val_0 = <0x00>;
        en_logic_dis_val_0 = <0x1>;
        en_logic_width_0 = <1>;
        en_logic_dev_1 = "/dev/cpld6";
        en_logic_addr_1 = <0x42>;
        en_logic_mask_1 = <0xfe>;
        en_logic_en_val_1 = <0x0>;
        en_logic_dis_val_1 = <0x1>;
        en_logic_width_1 = <1>;
        en_logic_dev_2 = "/dev/cpld6";
        en_logic_addr_2 = <0x45>;
        en_logic_mask_2 = <0xfc>;
        en_logic_en_val_2 = <0x2>;
        en_logic_dis_val_2 = <0x0>;
        en_logic_width_2 = <1>;
        en_logic_dev_3 = "/dev/cpld6";
        en_logic_addr_3 = <0x46>;
        en_logic_mask_3 = <0xf8>;
        en_logic_en_val_3 = <0x6>;
        en_logic_dis_val_3 = <0x0>;
        en_logic_width_3 = <1>;
    };

    /* BIOS Upgrade link */
    firmware_bios {
        compatible  = "firmware_sysfs";
        type        = "MTD_DEV";
        chain       = <4>;
        chip_index  = <1>;
        mtd_name    = "BIOS";
        flash_base  = <0x0>;
    };

    led_wdt: led_wdt {
        compatible = "wb_wdt";
        feed_wdt_type = /bits/ 8 <0x2>;   /* 0: does not feed the dog, 1:hrtimer feeds the dog, 2: threads feed the dog */
        hw_margin_ms = <180000>;          /* Timeout period */
        feed_time = <30000>;              /* Dog feeding time */
        config_dev_name = "/dev/cpld6";   /* Configuring CPLD */
        config_mode = /bits/ 8 <2>;       /* 1:GPIO feed the dog, 2: logic device feed the dog */
        priv_func_mode = /bits/ 8 <1>;    /* 1:i2c, 2:pcie, 3:IO, 4:Device file */
        enable_reg = <0xb6>;              /* Enable register. Note: This led_wdt has no enable register and is compatible with driver configuration as a dog feed register */
        enable_val = /bits/ 8 <0x1>;      /* Enable value */
        disable_val = /bits/ 8 <0x0>;     /* Disabled value */
        enable_mask = /bits/ 8 <0x1>;     /* Enable the mask */
        timeout_cfg_reg = <0xb8>;         /* Time setting register */
        timeleft_cfg_reg = <0xb9>;         /* Residual time register */
        hw_algo = "toggle";               /* toggle: Flip, level: level level */
        feed_dev_name = "/dev/cpld6";     /* Logic device feed dog register */
        feed_reg = <0xb7>;                /* Dog feed register */
        active_val = /bits/ 8 <0x1>;      /* Dog feed value */
        logic_func_mode = /bits/ 8 <0x1>; /* 1:i2c, 2:pcie, 3:IO, 4:Device file */
        timer_accuracy = <6000>;          /* 6s */
    };

    wb_mmc_resume@0 {
        compatible = "dev_resume_drv";
        dev_type   = <1>;                             /* 1: MMC; 2: SSD */
        slot_id    = <0>;                             /* emmc controller0 */
        bit_mask   = <0x01>;
        reg_intf_name   = "mmc_resume_register";
        unreg_intf_name = "mmc_resume_unregister";

        resume_way0 {
            resume_way    = <3>;                     /* way3 DEV_RESUME_WAY2_CTL_GPIO */
            gpio_num      = <986>;
            active_level  = <0>;
            reset_delay   = <10000>;
            dereset_delay = <5000>;
        };
    };


};

