    fpga-i2c8 {
        compatible = "wb-fpga-i2c";
        i2c_timeout             = <3000>;
        i2c_scale               = <0xe00>;
        i2c_filter              = <0xe04>;
        i2c_stretch             = <0xe08>;
        i2c_ext_9548_exits_flag = <0xe0c>;
