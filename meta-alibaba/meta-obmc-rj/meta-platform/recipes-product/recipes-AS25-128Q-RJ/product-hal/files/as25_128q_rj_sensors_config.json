    "EVST_SENSORS": {
        "APLL_EVENT": {
            "Descr": "PLL lock history",
            "Default": "0",
            "Decoder": {
                "0": "Never",
                "1": "Locked to Unlocked",
                "2": "Unlocked to Locked",
                "3": "Unlocked to Locked or Locked to Unlocked"
            },
            "RW": "RW",
            "Expects": ["0"]
        },
        "APLL_STS": {
            "Descr": "PLL lock status",
            "Default": "0",
            "Decoder": {
                "0": "Unlocked",
                "1": "Locked"
            },
            "RW": "RO",
            "Expects": ["1"]
        },
        "APLL_LOL_EVENT": {
            "Descr": "PLL lock de-assert count",
            "Default": "0",
            "Decoder": {
                "0": "Never",
                "1": "Lock de-asserts"
            },
            "RW": "RW",
            "Expects": ["0"]
        }
    }
